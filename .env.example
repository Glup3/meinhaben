# Astro reads public PocketBase content from this URL at build time.
POCKETBASE_URL=http://127.0.0.1:8090

# Optional canonical origin when building outside Coolify (export before build).
# SITE_URL=http://localhost:4321

# Optional server-only API origin; Docker Compose sets this to its internal service.
# POCKETBASE_INTERNAL_URL=http://pocketbase:8090

# Required by production Docker Compose; keep real values out of Git.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=
# Generate a 32-character key: openssl rand -hex 16
PB_ENCRYPTION_KEY=
