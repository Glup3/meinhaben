# Astro reads public PocketBase content from this URL at request time.
POCKETBASE_URL=http://127.0.0.1:8090

# Optional canonical origin at build time (export before build).
# SITE_URL=http://localhost:4321

# Optional API origin reachable from the Node runtime (separate from public image URLs).
# Docker Compose uses http://pocketbase:8090 on its private service network.
# POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090

# Required by production Docker Compose; keep real values out of Git.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=
# Generate a 32-character key: openssl rand -hex 16
PB_ENCRYPTION_KEY=
