---
import Icon from './Icon.astro';
const slides = [
  { label: 'Gute Dinge dürfen weiterziehen', title: 'Heute noch meins.\nMorgen dein Lieblingsstück.', cta: 'Jetzt stöbern', href: '/anzeigen/', photos: ['sessel.jpg', 'lampe.jpg', 'kopfhoerer.jpg', 'pflanze.jpg'], theme: 'blue', tag: 'ZWEITE RUNDE. ERSTE WAHL.' },
  { label: 'Unbezahlbar günstig', title: 'Die besten Dinge\nkosten manchmal nichts.', cta: 'Zu verschenken entdecken', href: '/anzeigen/?gratis=1', photos: ['buecher.jpg', 'pflanze.jpg', 'kaffee.jpg', 'sessel.jpg'], theme: 'purple', tag: '0 EURO. VIEL FREUDE.' },
  { label: 'Exklusiv für Menschen mit Humor', title: 'Traumimmobilie?\nFast. Ein Sessel.', cta: 'Immobilien entdecken', href: '/immobilien/', photos: ['sessel.jpg', 'lampe.jpg', 'pflanze.jpg', 'buecher.jpg'], theme: 'orange', tag: 'LAGE, LAGE, SITZLAGE.' },
];
---
<section class="featured-carousel" aria-label="Meinhaben Empfehlungen" aria-roledescription="Karussell" data-carousel>
  <div class="showcase-slides" id="home-recommendations">
    {slides.map((slide, index) => <article class:list={["showcase-slide", `showcase-${slide.theme}`, { "is-active": index === 0 }]} aria-hidden={index !== 0} inert={index !== 0} aria-roledescription="Folie" aria-label={`${index + 1} von ${slides.length}`} data-slide>
      <div class="showcase-collage" aria-hidden="true">{slide.photos.map((photo, i) => <img class={`showcase-object object-${i}`} src={`/images/${photo}`} alt="" width="220" height="220" loading="eager" />)}<span class="showcase-sticker">{slide.tag}</span></div>
      <div class="showcase-copy"><p class="showcase-kicker">{slide.label}</p><h2>{slide.title}</h2><a href={slide.href}>{slide.cta}<Icon name="arrow" size={24} /></a><small>Gute Dinge. Kleine Geschichten. Große Gefühle.</small></div>
    </article>)}
    <div class="showcase-controls">
    <button type="button" class="showcase-arrow showcase-prev" aria-label="Vorherige Empfehlung" aria-controls="home-recommendations" data-prev><Icon name="left" size={18} /></button>
    <p class="showcase-status sr-only" aria-live="polite" aria-atomic="true" data-status>1 / {slides.length}</p>
    <button type="button" class="showcase-arrow showcase-next" aria-label="Nächste Empfehlung" aria-controls="home-recommendations" data-next><Icon name="right" size={18} /></button>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(root => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let transitioning = false;
    async function show(direction: number) {
      if (transitioning) return;
      const outgoing = slides[current];
      current = (current + direction + slides.length) % slides.length;
      const incoming = slides[current];
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === current);
        slide.setAttribute('aria-hidden', String(i !== current));
        slide.inert = i !== current;
      });
      root.querySelector('[data-status]')!.textContent = `${current + 1} / ${slides.length}`;
      if (reducedMotion.matches) return;
      transitioning = true;
      outgoing.classList.add('is-transitioning');
      const options = { duration: 400, easing: 'cubic-bezier(.22, .61, .36, 1)' };
      const animations = [
        outgoing.animate([{ transform: 'translateX(0)' }, { transform: `translateX(${-direction * 100}%)` }], options),
        incoming.animate([{ transform: `translateX(${direction * 100}%)` }, { transform: 'translateX(0)' }], options),
      ];
      await Promise.allSettled(animations.map(animation => animation.finished));
      outgoing.classList.remove('is-transitioning');
      transitioning = false;
    }
    root.querySelector('[data-prev]')!.addEventListener('click', () => void show(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => void show(1));
  });
</script>
