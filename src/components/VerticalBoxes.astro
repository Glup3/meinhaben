---
import Icon from "./Icon.astro";
const boxes = [
  {
    name: "Marktplatz",
    href: "/anzeigen/",
    icon: "market",
    text: "Gute Dinge finden – am vermutlich kleinsten Marktplatz Österreichs.",
  },
  {
    name: "Immobilien",
    href: "/immobilien/",
    icon: "home",
    text: "Dein neues Zuhause? Ich hätte erst mal einen Sessel.",
  },
  {
    name: "Auto & Motor",
    href: "/auto-motor/",
    icon: "car",
    text: "Große Gefühle. Kleiner Fuhrpark. Bitte anschnallen.",
  },
  {
    name: "Jobs",
    href: "/jobs/",
    icon: "briefcase",
    text: "Du suchst einen neuen Job? Ich suche jemanden zum Abholen.",
  },
];
---

<nav class="vertical-boxes" aria-label="Unsere Bereiche">
  {boxes.map((box) => (
    <a class="vertical-card" href={box.href}>
      <div class="vertical-heading">
        <Icon name={box.icon} size={32} />
        <h2>{box.name}</h2>
      </div>
      <p>{box.text}</p>
    </a>
  ))}
</nav>

<style>
  .vertical-boxes {
    margin-inline: 0;
    margin-top: 24px;
    margin-bottom: 12px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    @media (width < 760px) {
      display: none;
    }
  }
  .vertical-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 5px;
    border: 1px solid var(--color-line);
    background-color: #f2f9fd;
    transition: none;
    & > p {
      display: flex;
      min-height: 0;
      flex: 1;
      align-items: center;
      padding-inline: 12px;
      padding-block: 8px;
      padding-top: 6px;
      padding-bottom: 12px;
      font-size: 12px;
      line-height: 1.4;
      color: var(--color-navy);
    }
    &:hover {
      transform: none;
      border-color: var(--color-brand);
    }
    @media (hover: hover) {
      &:hover {
        z-index: 1;
        transform: scale(1.025);
      }
    }
  }
  .vertical-heading {
    display: flex;
    min-height: 36px;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    background-color: transparent;
    padding-inline: 12px;
    padding-block: 7px;
    padding-top: 8px;
    padding-bottom: 0;
    color: var(--color-brand);
    & h2 {
      font-size: 14px;
      font-weight: 700;
    }
    & :global(svg) {
      height: 18px;
      width: 18px;
      color: var(--color-navy);
    }
  }
</style>
