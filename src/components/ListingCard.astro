---
import { formatPrice, statusLabels, type Listing } from '../data/listings';
import LoadingMessage from './LoadingMessage.astro';
interface Props { listing: Listing; eager?: boolean; }
const { listing, eager = false } = Astro.props;
---
<article data-ui="listing-card" class="relative min-w-0 bg-white border border-line rounded-ui [transition:box-shadow_150ms_ease-out] [@media(hover:hover)]:[&:hover]:[box-shadow:0_2px_5px_rgb(0_164_232_/_20%)] [[data-view=list]_&]:border-0 [[data-view=list]_&]:rounded-none [[data-view=list]_&]:py-3 [[data-view=list]_&]:px-4 max-[760px]:[[data-view=list]_&]:p-4 max-[760px]:[[data-ui~=related-section]_&:last-child:nth-child(odd)]:hidden [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_>_&]:grid [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_>_&]:grid-rows-subgrid [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_>_&]:row-span-3 [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_>_&]:gap-y-0" data-listing data-slug={listing.slug} data-condition={listing.condition} data-category={listing.category} data-status={listing.status} data-price={listing.price} data-date={listing.date} data-search={`${listing.title} ${listing.subtitle} ${listing.category} ${listing.condition}`}>
  <div class="flex flex-col h-full [[data-view=list]_&]:flex-row [[data-view=list]_&]:gap-4 [[data-view=list]_&]:min-h-37.5 max-[760px]:[[data-view=list]_&]:gap-3 max-[760px]:[[data-view=list]_&]:min-h-32 [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_>_[data-ui~=listing-card]_>_&]:grid [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_>_[data-ui~=listing-card]_>_&]:grid-rows-subgrid [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_>_[data-ui~=listing-card]_>_&]:row-span-3 [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_>_[data-ui~=listing-card]_>_&]:gap-y-0">
    <div class="relative aspect-[4/3] bg-[#f3f5fa] overflow-hidden [border-radius:calc(var(--radius-ui)_-_1px)_calc(var(--radius-ui)_-_1px)_0_0] [&_img]:w-full [&_img]:h-full [&_img]:object-contain [[data-view=list]_&]:w-50 [[data-view=list]_&]:h-37.5 [[data-view=list]_&]:rounded-none [[data-view=list]_&]:[flex:0_0_200px] [[data-status=sold]_&_img]:opacity-55 [[data-status=sold]_&_img]:[filter:grayscale(.6)] max-[760px]:[[data-view=list]_&]:w-30 max-[760px]:[[data-view=list]_&]:h-30 max-[760px]:[[data-view=list]_&]:[flex-basis:120px] max-[360px]:[[data-view=list]_&]:w-25 max-[360px]:[[data-view=list]_&]:h-27.5 max-[360px]:[[data-view=list]_&]:[flex-basis:100px] [[data-ui~=home-listing-rail]_&]:aspect-[4/3]"><img src={listing.image} alt={listing.imageAlt} width="1200" height="900" loading={eager ? 'eager' : 'lazy'} decoding="async" /><LoadingMessage /><span class="absolute left-1 top-1 max-w-[calc(100%_-_48px)] py-0.75 px-1.5 text-[10px] bg-[#ffffffed] text-[#536781] rounded-[2px] [[data-view=list]_&[data-status=available]]:hidden [&[data-status=reserved]]:bg-[#fff1d5] [&[data-status=reserved]]:text-[#8f6416] [&[data-status=sold]]:bg-[#e5e9f0]" data-status={listing.status}>{listing.status === 'available' ? (listing.price === 0 ? 'Kostenlos' : listing.condition) : statusLabels[listing.status]}</span></div>
    <div class="flex flex-col flex-1 min-w-0 p-3 [&_h3]:text-[15px] [&_h3]:font-semibold [&_h3]:leading-[1.4] [&_h3]:wrap-anywhere [[data-view=list]_&]:p-0 [[data-view=list]_&_h3]:text-[16px] max-[760px]:[[data-view=list]_&]:pr-0 max-[760px]:[[data-view=list]_&_h3]:text-[14px] max-[760px]:p-2.5 max-[760px]:[&_h3]:text-[14px] [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_&]:grid [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_&]:grid-rows-subgrid [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_&]:row-span-2 [:is([data-ui~=home-listing-rail],_[data-ui~=listing-grid]:not([data-view=list]))_&]:gap-y-0"><h3><a class="[&::after]:absolute [&::after]:inset-0 [&::after]:z-1 [&::after]:rounded-[inherit] [&::after]:[content:''] [&:focus-visible::after]:[outline:2px_solid_var(--color-navy)] [&:focus-visible::after]:[outline-offset:3px]" href={`/inserat/${listing.slug}/`}>{listing.title}</a></h3><div class="flex items-baseline flex-wrap gap-1.5 mt-1"><span class="font-bold text-[18px] text-brand-dark [&[data-free=true]]:text-[15px] [[data-status=sold]_&]:text-muted max-[760px]:text-[18px] max-[760px]:[&[data-free=true]]:text-[14px]" data-free={listing.price === 0}>{formatPrice(listing.price)}</span></div></div>
  </div>
</article>
