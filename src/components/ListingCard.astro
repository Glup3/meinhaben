---
import { formatPrice, statusLabels, type Listing } from "../data/listings";
import LoadingMessage from "./LoadingMessage.astro";
interface Props {
  listing: Listing;
  eager?: boolean;
}
const { listing, eager = false } = Astro.props;
---

<article
  data-ui="listing-card"
  class="listing-card"
  data-listing
  data-slug={listing.slug}
  data-condition={listing.condition}
  data-category={listing.category}
  data-status={listing.status}
  data-price={listing.price}
  data-date={listing.date}
  data-search={`${listing.title} ${listing.category} ${listing.condition}`}
>
  <div class="listing-content">
    <div class="listing-image">
      <img
        src={listing.image}
        alt={listing.imageAlt}
        width="1200"
        height="900"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
      <LoadingMessage />
      <span class="listing-status" data-status={listing.status}>
        {listing.status === "available"
          ? listing.price === 0
            ? "Kostenlos"
            : listing.condition
          : statusLabels[listing.status]}
      </span>
    </div>
    <div class="listing-summary">
      <h3>
        <a class="listing-link" href={`/inserat/${listing.slug}/`}>
          {listing.title}
        </a>
      </h3>
      <div class="listing-price-row">
        <span class="listing-price" data-free={listing.price === 0}>
          {formatPrice(listing.price)}
        </span>
      </div>
    </div>
  </div>
</article>

<style>
  .listing-card {
    position: relative;
    min-width: 0;
    border-radius: var(--radius-ui);
    border: 1px solid var(--color-line);
    background-color: white;
    transition: box-shadow 150ms ease-out;
    :global(
        :is(
          [data-ui~="home-listing-rail"],
          [data-ui~="listing-grid"]:not([data-view="list"])
        )
      )
      > & {
      grid-row: span 3 / span 3;
      display: grid;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
    @media (hover: hover) {
      &:hover {
        box-shadow: 0 2px 5px rgb(0 164 232 / 20%);
      }
    }
    @media (width < 760px) {
      :global([data-ui~="related-section"]) &:last-child:nth-child(odd) {
        display: none;
      }
    }
    :global([data-view="list"]) & {
      border-radius: 0;
      border-style: solid;
      border-width: 0;
      padding-inline: 16px;
      padding-block: 12px;
    }
    @media (width < 760px) {
      :global([data-view="list"]) & {
        padding: 16px;
      }
    }
  }
  .listing-content {
    display: flex;
    height: 100%;
    flex-direction: column;
    :global(
        :is(
          [data-ui~="home-listing-rail"],
          [data-ui~="listing-grid"]:not([data-view="list"])
        )
      )
      > :global([data-ui~="listing-card"])
      > & {
      grid-row: span 3 / span 3;
      display: grid;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
    :global([data-view="list"]) & {
      min-height: 150px;
      flex-direction: row;
      gap: 16px;
    }
    @media (width < 760px) {
      :global([data-view="list"]) & {
        min-height: 128px;
        gap: 12px;
      }
    }
  }
  .listing-image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: calc(var(--radius-ui) - 1px) calc(var(--radius-ui) - 1px) 0 0;
    background-color: #f3f5fa;
    & img {
      height: 100%;
      width: 100%;
      object-fit: contain;
    }
    :global([data-status="sold"]) & img {
      opacity: 55%;
      filter: grayscale(0.6);
    }
    :global([data-ui~="home-listing-rail"]) & {
      aspect-ratio: 4/3;
    }
    :global([data-view="list"]) & {
      height: 150px;
      width: 200px;
      flex: 0 0 200px;
      border-radius: 0;
    }
    @media (width < 760px) {
      :global([data-view="list"]) & {
        height: 120px;
        width: 120px;
        flex-basis: 120px;
      }
    }
    @media (width < 360px) {
      :global([data-view="list"]) & {
        height: 110px;
        width: 100px;
        flex-basis: 100px;
      }
    }
  }
  .listing-status {
    position: absolute;
    top: 4px;
    left: 4px;
    max-width: calc(100% - 48px);
    border-radius: 2px;
    background-color: #ffffffed;
    padding-inline: 6px;
    padding-block: 3px;
    font-size: 10px;
    color: #536781;
    &[data-status="reserved"] {
      background-color: #fff1d5;
      color: #8f6416;
    }
    &[data-status="sold"] {
      background-color: #e5e9f0;
    }
    :global([data-view="list"]) &[data-status="available"] {
      display: none;
    }
  }
  .listing-summary {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: 12px;
    @media (width < 760px) {
      padding: 10px;
    }
    & h3 {
      font-size: 15px;
      line-height: 1.4;
      font-weight: 600;
      overflow-wrap: anywhere;
    }
    @media (width < 760px) {
      & h3 {
        font-size: 14px;
      }
    }
    :global(
        :is(
          [data-ui~="home-listing-rail"],
          [data-ui~="listing-grid"]:not([data-view="list"])
        )
      )
      & {
      grid-row: span 2 / span 2;
      display: grid;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
    :global([data-view="list"]) & {
      padding: 0;
    }
    @media (width < 760px) {
      :global([data-view="list"]) & {
        padding-right: 0;
      }
    }
    :global([data-view="list"]) & h3 {
      font-size: 16px;
    }
    @media (width < 760px) {
      :global([data-view="list"]) & h3 {
        font-size: 14px;
      }
    }
  }
  .listing-link::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    content: "";
  }
  .listing-link:focus-visible::after {
    outline: 2px solid var(--color-navy);
    outline-offset: 3px;
  }
  .listing-price-row {
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
  }
  .listing-price {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-brand-dark);
    @media (width < 760px) {
      font-size: 18px;
    }
    &[data-free="true"] {
      font-size: 15px;
    }
    @media (width < 760px) {
      &[data-free="true"] {
        font-size: 14px;
      }
    }
    :global([data-status="sold"]) & {
      color: var(--color-muted);
    }
  }
</style>
