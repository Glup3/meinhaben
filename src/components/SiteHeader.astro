---
import Logo from "./Logo.astro";
import { verticals } from "../data/verticals";
const pathname = Astro.url.pathname.replace(/\/$/, "");
const marketActive =
  pathname === "/anzeigen" || pathname.startsWith("/inserat/");
---

<header class="site-header">
  <div data-ui="header-inner" class="header-inner">
    <span data-nav-oval class="nav-oval" aria-hidden="true"></span>
    <a
      data-header-logo
      class="header-logo"
      href="/"
      aria-label="Meinhaben – Startseite"
    >
      <Logo />
    </a>
    <nav data-market-nav class="market-nav" aria-label="Marktplatz">
      <a href="/anzeigen/" aria-current={marketActive ? "page" : undefined}>
        Marktplatz
      </a>
      {verticals.map((vertical) => (
        <a
          href={`/${vertical.slug}/`}
          aria-current={pathname === `/${vertical.slug}` ? "page" : undefined}
        >
          {vertical.name}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-ui~=header-inner]')!;
  const nav = header.querySelector<HTMLElement>('[data-market-nav]')!;
  const logo = header.querySelector<HTMLElement>('[data-header-logo]')!;
  const oval = header.querySelector<HTMLElement>('[data-nav-oval]')!;
  const currentLink = nav.querySelector<HTMLElement>('[aria-current=page]');
  let visible = false;
  let activeLink: HTMLElement | null = null;

  function moveTo(link: HTMLElement, immediate = false) {
    if (visible && activeLink === link) return;
    activeLink = link;
    const origin = header.getBoundingClientRect();
    const bounds = link.getBoundingClientRect();
    const start = logo.getBoundingClientRect();
    const width = bounds.width - 8;
    const height = Math.min(50, bounds.height - 8);
    const centerX = bounds.left + bounds.width / 2;
    // The rounded logo body is centered at y=27 in its 68-unit viewBox.
    const centerY = start.top + start.height * (27 / 68);
    oval.style.width = `${width}px`;
    oval.style.height = `${height}px`;
    if (!visible) {
      oval.style.transition = 'none';
      oval.style.transform = `translate(${start.left - origin.left + (start.width - width) / 2}px, ${centerY - origin.top - height / 2}px)`;
      oval.style.opacity = '0';
      // Commit the logo position before animating toward the item.
      oval.getBoundingClientRect();
      oval.style.removeProperty('transition');
      visible = true;
    }
    if (immediate) oval.style.transition = 'none';
    oval.style.opacity = '1';
    oval.style.transform = `translate(${centerX - origin.left - width / 2}px, ${centerY - origin.top - height / 2}px)`;
    if (immediate) {
      oval.getBoundingClientRect();
      oval.style.removeProperty('transition');
    }
  }
  function restore(immediate = false) {
    const focusedLink = nav.querySelector<HTMLElement>('a:focus-visible');
    const restingLink = focusedLink || currentLink;
    if (restingLink) moveTo(restingLink, immediate);
    else { visible = false; activeLink = null; oval.style.opacity = '0'; }
  }
  nav.addEventListener('pointerover', event => {
    if (event.pointerType === 'touch') return;
    const link = (event.target as Element).closest('a');
    if (link) moveTo(link);
  });
  nav.addEventListener('pointerleave', () => restore());
  nav.addEventListener('focusin', event => {
    const link = (event.target as Element).closest('a');
    if (link?.matches(':focus-visible')) moveTo(link);
  });
  nav.addEventListener('focusout', event => {
    if (!nav.contains(event.relatedTarget as Node | null)) restore();
  });
  function realign() { activeLink = null; restore(true); }
  nav.addEventListener('scroll', realign);
  window.addEventListener('resize', realign);
  restore(true);
</script>

<style>
  .site-header {
    background-color: white;
  }
  .header-inner {
    position: relative;
    isolation: isolate;
    margin-inline: auto;
    display: grid;
    width: min(1440px, calc(100% - 2 * var(--page-gutter)));
    grid-template-columns: 132px minmax(0, 1fr);
    grid-template-rows: 90px;
    column-gap: 40px;
    row-gap: 0;
    @media (width < 760px) {
      grid-template-columns: 120px minmax(0, 1fr);
      grid-template-rows: 64px 46px;
      column-gap: 12px;
      row-gap: 0;
    }
  }
  .nav-oval {
    pointer-events: none;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    border-radius: 999px;
    background-color: var(--color-panel);
    opacity: 0%;
    transition:
      transform 150ms ease-out,
      opacity 100ms ease-out;
  }
  .header-logo {
    display: block;
    width: 132px;
    position: relative;
    z-index: 1;
    grid-row: 1;
    transform: translateY(10.294%);
    align-self: center;
    @media (width < 760px) {
      grid-row: 1;
      margin: 0;
      width: 120px;
    }
  }
  .market-nav {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(4, max-content);
    justify-self: flex-end;
    @media (width < 760px) {
      grid-column: 1 / -1;
      margin-inline: -16px;
      grid-template-columns: repeat(4, minmax(120px, 1fr));
      justify-self: stretch;
      overflow-x: auto;
      padding-inline: 16px;
    }
    & [aria-current="page"] {
      color: var(--color-brand);
    }
    & [aria-current="page"] small {
      color: inherit;
    }
    & a {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border-bottom-style: solid;
      border-bottom-width: 4px;
      border-color: transparent;
      padding-inline: 12px;
      padding-block: 14px;
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
      text-transform: uppercase;
    }
    @media (width < 760px) {
      & a {
        padding-block: 10px;
      }
    }
    @media (width < 360px) {
      & a {
        padding-inline: 12px;
        font-size: 13px;
      }
    }
    & a:focus-visible {
      color: var(--color-navy);
    }
    & a:hover {
      color: var(--color-navy);
    }
    & small {
      font-size: 11px;
      font-weight: 400;
      color: var(--color-muted);
    }
    @media (width < 760px) {
      & small {
        display: none;
      }
    }
  }
</style>
