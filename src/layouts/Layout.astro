---
import '../styles/global.css';
import '../styles/marketplace.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { getListings, getCategories } from '../data/listings';
const [headerListings, headerCategories] = await Promise.all([getListings(), getCategories()]);
const populatedCategories = headerCategories.filter(category => headerListings.some(item => item.category === category.name));
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; }
const {
  title = 'Meinhaben – Vielleicht bald deins.',
  description = 'Meine Sachen suchen ein neues Zuhause. Ein kleiner privater Marktplatz für Freunde und Familie.',
  image = '/images/meinhaben-share.jpg',
  imageAlt = 'Meinhaben – Vielleicht bald deins. Gute Dinge dürfen weiterziehen.',
} = Astro.props;
// Use the public origin, even during builds and local previews. Filter/query
// variants share the same canonical page and social preview URL.
const canonicalURL = new URL(Astro.url.pathname, Astro.site!);
const imageURL = new URL(image, Astro.site!);
---
<!doctype html>
<html lang="de-AT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#00a4e8" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Meinhaben" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Zum Inhalt springen</a>
    <header class="site-header container">
      <div class="header-inner">
        <a class="logo" href="/" aria-label="Meinhaben – Startseite"><Logo /></a>
        <nav class="header-tools" aria-label="Hauptnavigation">
          <a class="header-search" href="/anzeigen/" aria-label="Anzeigen suchen"><Icon name="search" size={17} /><span>Suchen</span></a>
          <a href="/#so-gehts" aria-label="Kontakt und Übergabe"><Icon name="chat" size={16} /><span>Kontakt & Übergabe</span></a>
          <a class="saved-nav" href="/anzeigen/?gemerkt=1#dinge"><Icon name="star" size={17} /><span>Merkliste</span><span data-saved-count>0</span></a>
        </nav>
        <nav class="market-nav" aria-label="Marktplatz">
          <a href="/" class="market-nav-active">Marktplatz <small>{headerListings.length}</small></a>
          {populatedCategories.map(category => <a href={`/anzeigen/?kategorie=${encodeURIComponent(category.name)}#dinge`}>{category.name}<small>{headerListings.filter(item => item.category === category.name).length}</small></a>)}
        </nav>
      </div>
    </header>
    <slot />
    <p id="saved-status" class="sr-only" role="status" aria-live="polite"></p>
    <footer class="site-footer container">
      <div class="footer-columns">
        <div><h2>Über meinhaben</h2><a href="/#so-gehts">Kontakt & Übergabe</a><p>Mein privater Marktplatz.<br />Von mir, für Freunde & Familie.</p></div>
        <div><h2>Marktplatz</h2>{populatedCategories.map(category => <a href={`/anzeigen/?kategorie=${encodeURIComponent(category.name)}#dinge`}>{category.name}</a>)}</div>
        <div><h2>Dein nächster Fund</h2><a href="/anzeigen/">Alle Anzeigen</a><a href="/anzeigen/?gratis=1#dinge">Zu verschenken</a><a href="/anzeigen/?gemerkt=1#dinge">Meine Merkliste</a></div>
      </div>
      <div class="footer-bottom"><a class="logo" href="/" aria-label="Meinhaben – Startseite"><Logo /></a><span>Heute noch meins. Vielleicht morgen schon deins.</span></div>
    </footer>
  </body>
</html>

<script>
  import "../scripts/favorites";
</script>
