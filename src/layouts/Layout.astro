---
import '../styles/global.css';
import '../styles/marketplace.css';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; }
const {
  title = 'Meinhaben – Vielleicht bald deins.',
  description = 'Meine Sachen suchen ein neues Zuhause. Ein kleiner privater Marktplatz für Freunde und Familie.',
  image = '/images/meinhaben-share.jpg',
  imageAlt = 'Meinhaben – Vielleicht bald deins. Gute Dinge dürfen weiterziehen.',
} = Astro.props;
// Use the public origin, even during builds and local previews. Filter/query
// variants share the same canonical page and social preview URL.
const canonicalURL = new URL(Astro.url.pathname, Astro.site!);
const imageURL = new URL(image, Astro.site!);
---
<!doctype html>
<html lang="de-AT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0082c3" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Meinhaben" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Zum Inhalt springen</a>
    <header class="site-header"><div class="container header-inner">
      <a class="logo" href="/" aria-label="Meinhaben – Startseite">mein<span>haben</span></a>
      <span class="brand-tagline">Was meins ist, kann deins werden.</span><nav class="header-nav" aria-label="Hauptnavigation"><a href="/#so-gehts">So funktioniert’s</a></nav>
      <a class="saved-nav" href="/?gemerkt=1#dinge"><Icon name="heart" size={19} /><span>Merkliste</span><span data-saved-count>0</span></a>
    </div><nav class="market-nav" aria-label="Marktplatz"><div class="container market-nav-inner"><a href="/#dinge" class="market-nav-active"><Icon name="grid" size={19} />Marktplatz</a><a href="/?gratis=1#dinge"><Icon name="box" size={19} />Zu verschenken</a><span class="market-nav-note">Privat. Persönlich. Ohne Gebühren.</span></div></nav></header>
    <slot />
    <p id="saved-status" class="sr-only" role="status" aria-live="polite"></p>
    <footer class="site-footer"><div class="container footer-inner"><div><a class="logo footer-logo" href="/">mein<span>haben</span></a><p>Weniger bei mir. Mehr Freude bei dir.</p></div><div class="footer-note"><span>Ein privater Marktplatz für Freunde & Familie.</span><span>Schon irgendwie bekannt. Aber alles meins. <Icon name="leaf" size={15} /></span></div></div></footer>
  </body>
</html>

<script>
  import "../scripts/favorites";
</script>
