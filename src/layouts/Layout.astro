---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import SiteHeader from "../components/SiteHeader.astro";
import DittoOutline from "../components/DittoOutline.astro";
import { verticals } from "../data/verticals";
import type { Listing, Category } from "../data/listings";
interface Props {
  listings?: Listing[];
  categories?: Category[];
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}
const {
  listings = [], categories = [],
  title = "Meinhaben – Vielleicht bald deins.",
  description = "Meine Sachen suchen ein neues Zuhause. Ein kleiner privater Marktplatz für Freunde und Familie.",
  image = "/images/meinhaben-share.jpg",
  imageAlt = "Meinhaben – Vielleicht bald deins. Gute Dinge dürfen weiterziehen.",
} = Astro.props;
const populatedCategories = categories.filter(category => listings.some(item => item.category === category.name));
// Use the public origin, even during builds and local previews. Filter/query
// variants share the same canonical page and social preview URL.
const canonicalURL = new URL(Astro.url.pathname, Astro.site!);
const imageURL = new URL(image, Astro.site!);
---

<!doctype html>
<html lang="de-AT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#00a4e8" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Meinhaben" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Zum Inhalt springen
    </a>
    <SiteHeader />
    <slot />
    <footer class="site-footer">
      <div class="footer-links">
        <div>
          <h2>Über meinhaben</h2>
          <a href="/#so-gehts">Kontakt & Übergabe</a>
        </div>
        <div>
          <h2>Marktplatz</h2>
          {populatedCategories.map((category) => (
            <a href="/anzeigen/#dinge">{category.name}</a>
          ))}
        </div>
        <div>
          <h2>Auch noch da</h2>
          {verticals.map((vertical) => (
            <a href={`/${vertical.slug}/`}>{vertical.name}</a>
          ))}
        </div>
        <div>
          <h2>Dein nächster Fund</h2>
          <a href="/anzeigen/">Alle Anzeigen</a>
          <a href="/anzeigen/#dinge">Zu verschenken</a>
        </div>
      </div>
      <div data-ui="footer-bottom" class="footer-bottom">
        <div class="footer-message">
          <p class="footer-tagline">
            Meine Sachen = Dein nächstes Lieblingsstück!
          </p>
          <p class="footer-description">
            Mein privater Marktplatz.
            <br />
            Von mir, für Freunde & Familie.
          </p>
        </div>
        <a
          data-ui="footer-logo"
          class="footer-logo"
          href="/"
          aria-label="Meinhaben – Startseite"
        >
          <DittoOutline />
          <Logo />
        </a>
        <span>Heute noch meins. Vielleicht morgen schon deins.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 20;
    transform: translateY(-150%);
    background-color: white;
    padding: 12px;
    clip-path: inset(100%);
    &:focus {
      transform: none;
      clip-path: none;
    }
  }
  .site-footer {
    margin-inline: auto;
    width: min(1440px, calc(100% - 2 * var(--page-gutter)));
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(4, max-content);
    justify-content: center;
    gap: 32px;
    padding-inline: 16px;
    padding-block: 20px;
    text-align: center;
    @media (width < 760px) {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      padding-inline: 0;
    }
    & a {
      display: block;
      font-size: 13px;
      line-height: 2;
    }
    & a:hover {
      text-decoration-line: underline;
    }
    & h2 {
      margin-bottom: 10px;
      font-size: 14px;
    }
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-inline: 16px;
    padding-top: 24px;
    padding-bottom: 16px;
    font-size: 11px;
    color: var(--color-muted);
    @media (width < 760px) {
      gap: 16px;
      padding-inline: 0;
      & > span {
        max-width: 170px;
        text-align: right;
      }
    }
  }
  .footer-message {
    margin-bottom: 16px;
    flex-shrink: 0;
    flex-grow: 0;
    flex-basis: 100%;
    text-align: center;
  }
  .footer-tagline {
    margin-inline: 0;
    margin-top: 0;
    margin-bottom: 12px;
    text-align: center;
    font-size: 18px;
    line-height: 1.6;
    font-weight: 600;
    color: var(--color-navy);
  }
  .footer-description {
    font-size: 12px;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .footer-logo {
    position: relative;
    isolation: isolate;
    display: block;
    width: 110px;
  }
</style>
