---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import DittoOutline from '../components/DittoOutline.astro';
import { verticals } from '../data/verticals';
const marketActive = Astro.url.pathname.startsWith('/anzeigen') || Astro.url.pathname.startsWith('/inserat');
import { getListings, getCategories } from '../data/listings';
const [headerListings, headerCategories] = await Promise.all([getListings(), getCategories()]);
const populatedCategories = headerCategories.filter(category => headerListings.some(item => item.category === category.name));
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; }
const {
  title = 'Meinhaben – Vielleicht bald deins.',
  description = 'Meine Sachen suchen ein neues Zuhause. Ein kleiner privater Marktplatz für Freunde und Familie.',
  image = '/images/meinhaben-share.jpg',
  imageAlt = 'Meinhaben – Vielleicht bald deins. Gute Dinge dürfen weiterziehen.',
} = Astro.props;
// Use the public origin, even during builds and local previews. Filter/query
// variants share the same canonical page and social preview URL.
const canonicalURL = new URL(Astro.url.pathname, Astro.site!);
const imageURL = new URL(image, Astro.site!);
---
<!doctype html>
<html lang="de-AT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#00a4e8" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Meinhaben" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="fixed left-4 top-4 bg-white p-3 z-20 [transform:translateY(-150%)] [clip-path:inset(100%)] [&:focus]:[transform:none] [&:focus]:[clip-path:none]">Zum Inhalt springen</a>
    <header class="w-[min(1440px,_calc(100%_-_2_*_var(--page-gutter)))] mx-auto">
      <div data-ui="header-inner" class="relative isolate grid grid-cols-[132px_minmax(0,_1fr)] grid-rows-[90px] gap-y-0 gap-x-10 max-[760px]:grid-cols-[120px_minmax(0,_1fr)] max-[760px]:grid-rows-[64px_46px] max-[760px]:gap-y-0 max-[760px]:gap-x-3">
        <span data-nav-oval class="absolute top-0 left-0 z-0 rounded-[999px] bg-panel pointer-events-none opacity-0 [transition:transform_150ms_ease-out,_opacity_100ms_ease-out]" aria-hidden="true"></span>
        <a data-header-logo class="block w-33 [[data-ui~=header-inner]_>_&]:relative [[data-ui~=header-inner]_>_&]:z-1 [[data-ui~=header-inner]_>_&]:self-center [[data-ui~=header-inner]_>_&]:[grid-row:1] [[data-ui~=header-inner]_>_&]:[transform:translateY(10.294%)] [[data-ui~=footer-bottom]_&]:w-27.5 max-[760px]:[[data-ui~=header-inner]_>_&]:w-30 max-[760px]:[[data-ui~=header-inner]_>_&]:m-0 max-[760px]:[[data-ui~=header-inner]_>_&]:[grid-row:1]" href="/" aria-label="Meinhaben – Startseite"><Logo /></a>
        <nav data-market-nav class="grid grid-cols-[repeat(4,_max-content)] justify-self-end [grid-column:2] [&_a]:relative [&_a]:z-1 [&_a]:flex [&_a]:items-center [&_a]:justify-center [&_a]:gap-2 [&_a]:py-3.5 [&_a]:uppercase [&_a]:border-b-4 [&_a]:border-transparent [&_a]:whitespace-nowrap [&_a]:font-semibold [&_a]:px-3 [&_a]:text-[13px] [&_small]:text-muted [&_small]:text-[11px] [&_small]:font-normal [&_[aria-current=page]]:text-brand [&_a:hover]:text-navy [&_a:focus-visible]:text-navy [&_[aria-current=page]_small]:text-inherit max-[760px]:col-span-full max-[760px]:justify-self-stretch max-[760px]:grid-cols-[repeat(4,_minmax(120px,_1fr))] max-[760px]:-mx-4 max-[760px]:px-4 max-[760px]:overflow-x-auto max-[760px]:[&_a]:py-2.5 max-[760px]:[&_small]:hidden max-[360px]:[&_a]:px-3 max-[360px]:[&_a]:text-[13px]" aria-label="Marktplatz">
          <a href="/anzeigen/"  aria-current={marketActive ? 'page' : undefined}>Marktplatz</a>
          {verticals.map(vertical => <a href={`/${vertical.slug}/`}  aria-current={Astro.url.pathname.replace(/\/$/, '') === `/${vertical.slug}` ? 'page' : undefined}>{vertical.name}</a>)}
        </nav>
      </div>
    </header>
    <slot />
    <footer class="w-[min(1440px,_calc(100%_-_2_*_var(--page-gutter)))] mx-auto">
      <div class="[&_a:hover]:underline grid grid-cols-[repeat(4,_max-content)] justify-center gap-8 py-5 px-4 text-center [&_h2]:text-[14px] [&_h2]:mb-2.5 [&_a]:block [&_a]:text-[13px] [&_a]:leading-[2] max-[760px]:grid-cols-[1fr_1fr] max-[760px]:gap-6 max-[760px]:px-0">
        <div><h2>Über meinhaben</h2><a href="/#so-gehts">Kontakt & Übergabe</a></div>
        <div><h2>Marktplatz</h2>{populatedCategories.map(category => <a href="/anzeigen/#dinge">{category.name}</a>)}</div>
        <div><h2>Auch noch da</h2>{verticals.map(vertical => <a href={`/${vertical.slug}/`}>{vertical.name}</a>)}</div>
        <div><h2>Dein nächster Fund</h2><a href="/anzeigen/">Alle Anzeigen</a><a href="/anzeigen/#dinge">Zu verschenken</a></div>
      </div>
      <div data-ui="footer-bottom" class="flex flex-wrap items-center justify-between gap-5 pt-6 px-4 pb-4 text-[11px] text-muted max-[760px]:px-0 max-[760px]:gap-4 max-[760px]:[&_>_span]:max-w-42.5 max-[760px]:[&_>_span]:text-right"><div class="basis-full shrink-0 grow-0 mb-4 text-center"><p class="mt-0 mx-0 mb-3 text-center text-navy text-[18px] font-semibold leading-[1.6]">Meine Sachen = Dein nächstes Lieblingsstück!</p><p class="text-[12px] leading-[1.7] text-muted">Mein privater Marktplatz.<br />Von mir, für Freunde & Familie.</p></div><a data-ui="footer-logo" class="block w-33 relative isolate [[data-ui~=header-inner]_>_&]:relative [[data-ui~=header-inner]_>_&]:z-1 [[data-ui~=header-inner]_>_&]:self-center [[data-ui~=header-inner]_>_&]:[grid-row:1] [[data-ui~=header-inner]_>_&]:[transform:translateY(10.294%)] [[data-ui~=footer-bottom]_&]:w-27.5 max-[760px]:[[data-ui~=header-inner]_>_&]:w-30 max-[760px]:[[data-ui~=header-inner]_>_&]:m-0 max-[760px]:[[data-ui~=header-inner]_>_&]:[grid-row:1]" href="/" aria-label="Meinhaben – Startseite"><DittoOutline /><Logo /></a><span>Heute noch meins. Vielleicht morgen schon deins.</span></div>
    </footer>
  </body>
</html>

<script>
  const header = document.querySelector<HTMLElement>('[data-ui~=header-inner]')!;
  const nav = header.querySelector<HTMLElement>('[data-market-nav]')!;
  const logo = header.querySelector<HTMLElement>('[data-header-logo]')!;
  const oval = header.querySelector<HTMLElement>('[data-nav-oval]')!;
  const currentLink = nav.querySelector<HTMLElement>('[aria-current=page]');
  let visible = false;
  let activeLink: HTMLElement | null = null;

  function moveTo(link: HTMLElement, immediate = false) {
    if (visible && activeLink === link) return;
    activeLink = link;
    const origin = header.getBoundingClientRect();
    const bounds = link.getBoundingClientRect();
    const start = logo.getBoundingClientRect();
    const width = bounds.width - 8;
    const height = Math.min(50, bounds.height - 8);
    const centerX = bounds.left + bounds.width / 2;
    // The rounded logo body is centered at y=27 in its 68-unit viewBox.
    const centerY = start.top + start.height * (27 / 68);
    oval.style.width = `${width}px`;
    oval.style.height = `${height}px`;
    if (!visible) {
      oval.style.transition = 'none';
      oval.style.transform = `translate(${start.left - origin.left + (start.width - width) / 2}px, ${centerY - origin.top - height / 2}px)`;
      oval.style.opacity = '0';
      // Commit the logo position before animating toward the item.
      oval.getBoundingClientRect();
      oval.style.removeProperty('transition');
      visible = true;
    }
    if (immediate) oval.style.transition = 'none';
    oval.style.opacity = '1';
    oval.style.transform = `translate(${centerX - origin.left - width / 2}px, ${centerY - origin.top - height / 2}px)`;
    if (immediate) {
      oval.getBoundingClientRect();
      oval.style.removeProperty('transition');
    }
  }
  function restore(immediate = false) {
    const focusedLink = nav.querySelector<HTMLElement>('a:focus-visible');
    const restingLink = focusedLink || currentLink;
    if (restingLink) moveTo(restingLink, immediate);
    else { visible = false; activeLink = null; oval.style.opacity = '0'; }
  }
  nav.addEventListener('pointerover', event => {
    if (event.pointerType === 'touch') return;
    const link = (event.target as Element).closest('a');
    if (link) moveTo(link);
  });
  nav.addEventListener('pointerleave', () => restore());
  nav.addEventListener('focusin', event => {
    const link = (event.target as Element).closest('a');
    if (link?.matches(':focus-visible')) moveTo(link);
  });
  nav.addEventListener('focusout', event => {
    if (!nav.contains(event.relatedTarget as Node | null)) restore();
  });
  function realign() { activeLink = null; restore(true); }
  nav.addEventListener('scroll', realign);
  window.addEventListener('resize', realign);
  restore(true);
</script>
