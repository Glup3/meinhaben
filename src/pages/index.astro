---
import Layout from '../layouts/Layout.astro';
import AdCarousel from '../components/AdCarousel.astro';
import VerticalBoxes from '../components/VerticalBoxes.astro';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import { getListings } from '../data/listings';
const listings = await getListings();
const latest = listings.filter(item => item.status === "available" && item.price > 0).slice(0, 4);
const freeListings = listings.filter(item => item.status === "available" && item.price === 0).slice(0, 4);
---
<Layout>
  <main id="main" class="container home-main">
    <div class="marketplace-title"><h1>Der vermutlich kleinste Marktplatz Österreichs</h1><span>{listings.length} Anzeigen</span></div>
    <AdCarousel />
    <VerticalBoxes />
    <section class="home-picks" id="dinge" aria-labelledby="new-heading">
      <div class="home-section-heading"><h2 id="new-heading" class="section-label">Frisch auf meinhaben</h2><a href="/anzeigen/">Alle Anzeigen <Icon name="right" size={15} /></a></div>
      <div class="home-listing-rail">{latest.map(listing => <ListingCard listing={listing} />)}</div>
    </section>
    <section class="home-callout" aria-labelledby="callout-heading"><Icon name="chat" size={40} /><div><h2 id="callout-heading">Gefunden? Dann lass von dir hören.</h2><p>Meine Sachen. Dein nächstes Lieblingsstück. Alles Weitere machen wir uns persönlich aus.</p></div><a class="button outline" href="#so-gehts">Kontakt & Übergabe</a></section>
    {freeListings.length > 0 && <section class="home-picks" aria-labelledby="free-heading"><div class="home-section-heading"><h2 id="free-heading" class="section-label">Zu verschenken</h2><a href="/anzeigen/?gratis=1">Alle ansehen <Icon name="right" size={15} /></a></div><div class="home-listing-rail">{freeListings.map(listing => <ListingCard listing={listing} />)}</div></section>}
    <section class="how-section" id="so-gehts" aria-labelledby="how-heading"><h2 id="how-heading">Kontakt & Übergabe</h2><div class="how-columns"><div><h3><Icon name="search" size={20} />Lieblingsstück finden</h3><p>Alle Anzeigen sind aus meinem eigenen Haushalt. Schau dir Fotos, Zustand und Beschreibung an.</p></div><div><h3><Icon name="chat" size={20} />Nachricht schreiben</h3><p>Schreib mir auf WhatsApp als <a href="https://wa.me/glup3">@glup3</a>. Den passenden Nachrichtentext findest du beim Artikel.</p></div><div><h3><Icon name="box" size={20} />Übergabe ausmachen</h3><p>Alles Weitere besprechen wir persönlich. Ohne Anmeldung und ohne Gebühren.</p></div></div></section>
  </main>
</Layout>
<script>
  // Keep previously shared homepage filter URLs working after splitting discovery and results.
  const filters = ['q', 'kategorie', 'gratis', 'budget', 'zustand', 'verfuegbar', 'sortierung'];
  const params = new URLSearchParams(location.search);
  if (filters.some(key => params.has(key))) location.replace(`/anzeigen/${location.search}${location.hash}`);
</script>
