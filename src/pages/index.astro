---
import Layout from '../layouts/Layout.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import VerticalBoxes from '../components/VerticalBoxes.astro';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import { getListings } from '../data/listings';
const listings = await getListings();
const latest = listings.filter(item => item.status === "available" && item.price > 0).slice(0, 8);
const freeListings = listings.filter(item => item.status === "available" && item.price === 0).slice(0, 8);
---
<Layout>
  <main id="main" class="w-[min(1440px,_calc(100%_-_2_*_var(--page-gutter)))] mx-auto pt-4.25 max-[760px]:pt-0">
    <div class="flex items-baseline gap-1.5 mb-2.5 [&_h1]:text-brand [&_h1]:text-[16px] [&_h1]:font-bold [&_>_span]:text-[14px] [&_>_span]:border-l [&_>_span]:border-muted [&_>_span]:pl-1.5 max-[760px]:absolute max-[760px]:w-0.25 max-[760px]:h-0.25 max-[760px]:overflow-hidden max-[760px]:whitespace-nowrap max-[760px]:[clip-path:inset(100%)]"><h1>Der vermutlich kleinste Marktplatz Österreichs</h1><span>{listings.length} Anzeigen</span></div>
    <FeaturedCarousel />
    <VerticalBoxes />
    <section class="py-6 px-4 border-t border-line max-[760px]:py-6 max-[760px]:px-0" id="dinge" aria-labelledby="new-heading">
      <div data-ui="home-section-heading" class="flex justify-between items-baseline gap-4 mb-3.5 [&_>_a]:inline-flex [&_>_a]:items-center [&_>_a]:gap-1 [&_>_a]:text-brand-dark [&_>_a]:text-[12px] [&_>_a]:whitespace-nowrap"><h2 id="new-heading" class="text-[14px] leading-[1.4] uppercase text-muted font-bold mb-3 [[data-ui~=home-section-heading]_&]:mb-0 flex items-center gap-2 [&_svg]:text-brand"><Icon name="sprout" size={24} />Frisch auf meinhaben</h2><a class="[transition:transform_150ms_ease-out] [transform-origin:right_center] [@media(hover:hover)]:[&:hover]:[transform:scale(1.06)]" href="/anzeigen/">Alle Anzeigen <Icon name="right" size={15} /></a></div>
      <div data-ui="home-listing-rail" class="grid grid-flow-col auto-cols-[clamp(230px,_calc((100%_-_80px)_/_5),_260px)] gap-5 overflow-x-auto p-2 -mx-2 grid-rows-[repeat(4,_auto)] max-[760px]:auto-cols-[160px] max-[760px]:gap-3 max-[760px]:-mr-4 max-[760px]:pr-4">{latest.map(listing => <ListingCard listing={listing} />)}</div>
    </section>
    {freeListings.length > 0 && <section class="py-6 px-4 border-t border-line max-[760px]:py-6 max-[760px]:px-0" aria-labelledby="free-heading"><div data-ui="home-section-heading" class="flex justify-between items-baseline gap-4 mb-3.5 [&_>_a]:inline-flex [&_>_a]:items-center [&_>_a]:gap-1 [&_>_a]:text-brand-dark [&_>_a]:text-[12px] [&_>_a]:whitespace-nowrap"><h2 id="free-heading" class="text-[14px] leading-[1.4] uppercase text-muted font-bold mb-3 [[data-ui~=home-section-heading]_&]:mb-0 flex items-center gap-2 [&_svg]:text-brand"><Icon name="gift" size={24} />ZU VERSCHENKEN</h2><a class="[transition:transform_150ms_ease-out] [transform-origin:right_center] [@media(hover:hover)]:[&:hover]:[transform:scale(1.06)]" href="/anzeigen/?gratis=1">Alle Anzeigen <Icon name="right" size={15} /></a></div><div data-ui="home-listing-rail" class="grid grid-flow-col auto-cols-[clamp(230px,_calc((100%_-_80px)_/_5),_260px)] gap-5 overflow-x-auto p-2 -mx-2 grid-rows-[repeat(4,_auto)] max-[760px]:auto-cols-[160px] max-[760px]:gap-3 max-[760px]:-mr-4 max-[760px]:pr-4">{freeListings.map(listing => <ListingCard listing={listing} />)}</div></section>}
    <section class="border-t-4 border-brand bg-[#eaf8ff] py-10 px-8 mt-6 mb-0 [border-radius:8px_8px_0_0] [&_>_h2]:text-center [&_>_h2]:mb-7 [&_>_h2]:text-navy [&_>_h2]:text-[28px] [&_>_h2]:font-bold max-[760px]:py-7 max-[760px]:px-5 max-[760px]:mb-0 max-[760px]:[&_>_h2]:text-[25px] max-[760px]:[&_>_h2]:mb-7" id="so-gehts" aria-labelledby="how-heading"><h2 id="how-heading">Kontakt & Übergabe</h2><div class="mb-8 [&_h3]:text-[18px] [&_h3]:mb-2"><h3>Gefunden wonach du gesucht hast?<span class="block text-left my-4">Oder vielleicht sogar was gefunden, was du eigentlich nicht gesucht hast?</span>Dann meld dich bei mir!</h3></div><div class="grid grid-cols-[repeat(3,_1fr)] gap-7 [&_h3]:flex [&_h3]:items-center [&_h3]:justify-center [&_h3]:gap-2.5 [&_h3]:mb-3.5 [&_h3]:text-[16px] [&_h3]:text-center [&_h3_svg]:w-6.5 [&_h3_svg]:h-6.5 [&_svg]:text-brand-dark [&_a]:text-brand-dark [&_p]:text-[15px] [&_p]:leading-[1.8] [&_p]:text-center max-[760px]:grid-cols-[1fr] max-[760px]:gap-7"><div><h3><Icon name="search" size={20} /><span>1. Lieblingsstück finden</span></h3><p>Alle Anzeigen sind aus meinem eigenen Haushalt. Schau dir Fotos, Zustand und Beschreibung an.</p></div><div><h3><Icon name="chat" size={20} /><span>2. Nachricht schreiben</span></h3><p>Schreib mir auf WhatsApp als <a href="https://wa.me/glup3">@glup3</a>. Den passenden Nachrichtentext findest du beim Artikel.</p></div><div><h3><Icon name="box" size={20} /><span>3. Übergabe ausmachen</span></h3><p>Alles Weitere besprechen wir persönlich. Ohne Anmeldung und ohne Gebühren.</p></div></div></section>
  </main>
</Layout>
<script>
  // Keep previously shared homepage filter URLs working after splitting discovery and results.
  const filters = ['q', 'kategorie', 'gratis', 'budget', 'zustand', 'verfuegbar', 'sortierung'];
  const params = new URLSearchParams(location.search);
  if (filters.some(key => params.has(key))) location.replace(`/anzeigen/${location.search}${location.hash}`);
</script>
