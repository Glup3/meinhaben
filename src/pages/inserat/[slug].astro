---
import PhotoGallery from "../../components/react/PhotoGallery";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import ListingCard from "../../components/ListingCard.astro";
import {
  getListings,
  formatPrice,
  statusLabels,
  type Listing,
} from "../../data/listings";
export async function getStaticPaths() {
  const listings = await getListings();
  return listings.map((listing) => ({
    params: { slug: listing.slug },
    props: { listing },
  }));
}
interface Props {
  listing: Listing;
}
const { listing } = Astro.props;
const listings = await getListings();
const photos = [
  { src: listing.image, alt: listing.imageAlt },
  ...(listing.extraImages || []),
];
const related = listings
  .filter((item) => item.slug !== listing.slug && item.status !== "sold")
  .sort(
    (a, b) =>
      Number(b.category === listing.category) -
      Number(a.category === listing.category),
  )
  .slice(0, 3);
const message = `Hey! Ich interessiere mich für „${listing.title}“ auf Meinhaben. Ist das noch zu haben?`;
---

<Layout
  title={`${listing.title} – Meinhaben`}
  description={listing.description[0]}
  image={listing.image}
  imageAlt={listing.imageAlt}
>
  <main id="main" class="listing-page">
    <nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
      <a href="/">Startseite</a>
      <Icon name="right" />
      <a href="/anzeigen/#dinge">{listing.category}</a>
      <Icon name="right" />
      <span aria-current="page">{listing.title}</span>
    </nav>
    <div class="title-row">
      <h1 id="listing-title">{listing.title}</h1>
      <div data-ui="detail-actions" class="detail-actions">
        <button
          type="button"
          class="share-button"
          id="share-listing"
          aria-label="Anzeige teilen"
        >
          <Icon name="share" size={19} />
          <span class="share-label">Teilen</span>
        </button>
      </div>
    </div>
    <div class="listing-meta">
      <span>
        {listing.category} · {listing.condition}
      </span>
      <span>
        Veröffentlicht:{" "}
        {new Date(listing.date).toLocaleDateString("de-AT", {
          timeZone: "Europe/Vienna",
        })}{" "}
        | meinhaben-Code: {listing.slug}
      </span>
    </div>
    <p id="share-status" role="status" class="share-status"></p>
    <div class="detail-layout">
      <PhotoGallery photos={photos} client:load />
      <section
        data-ui="detail-info"
        class="detail-info"
        aria-label="Preis und Kontakt"
      >
        <div class="detail-price">
          <strong>{formatPrice(listing.price)}</strong>
          <small>
            {listing.price === 0 ? "Zu verschenken" : "Verkaufspreis"}
          </small>
        </div>
        <span class="availability" data-status={listing.status}>
          <span class="status-dot"></span>
          {statusLabels[listing.status]}
        </span>
        {listing.status === "reserved" && (
          <p class="reserved-notice">
            Schon reserviert. Du kannst mir trotzdem schreiben, falls es doch
            wieder frei wird.
          </p>
        )}
        {listing.status === "sold" && (
          <p class="sold-notice">
            Dieses Stück ist schon vergeben. Schau dir gerne meine anderen
            Anzeigen an.
          </p>
        )}
        <button
          class="contact-button"
          id="contact-button"
          aria-haspopup="dialog"
          aria-controls="contact-dialog"
          disabled={listing.status === "sold"}
        >
          <Icon name={listing.status === "sold" ? "check" : "chat"} size={19} />
          {listing.status === "sold" ? "Bereits vergeben" : "Nachricht"}
        </button>
        <p class="contact-hint">Kontakt über WhatsApp · Ohne Anmeldung</p>
        <div class="seller">
          <span class="seller-avatar">
            <Icon name="user" size={36} />
          </span>
          <div>
            <strong>@glup3</strong>
            <small>Privat · Meine Sachen. Für euch.</small>
          </div>
        </div>
        {listing.price > 0 && listing.status !== "sold" && (
          <div class="last-price">
            <button
              type="button"
              class="last-price-button"
              id="last-price-button"
              aria-expanded="false"
              aria-controls="last-price-reply"
            >
              Was letzte Preis?
            </button>
            <p id="last-price-reply" role="status" hidden>
              Für dich? {formatPrice(listing.price)}. 😉
            </p>
          </div>
        )}
      </section>
      <section class="specs-section" aria-labelledby="specs-heading">
        <h2 id="specs-heading">Artikeldetails</h2>
        <dl class="specs">
          <div>
            <dt>Zustand</dt>
            <dd>{listing.condition}</dd>
          </div>
          {listing.details.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section
        class="description-section"
        aria-labelledby="description-heading"
      >
        <h2 id="description-heading">Beschreibung</h2>
        {listing.description.map((text) => (
          <p>{text}</p>
        ))}
      </section>
      <div class="personal-note">
        <Icon name="leaf" size={20} />
        <p>
          Von mir persönlich, aus meinem eigenen Haushalt. Wenn du Fragen hast
          oder dir etwas genauer ansehen möchtest, melde dich einfach.
        </p>
      </div>
    </div>
    <section
      data-ui="related-section"
      class="related-section"
      aria-labelledby="related-heading"
    >
      <div class="related-heading">
        <h2 id="related-heading">Weitere Anzeigen von mir</h2>
        <a href="/anzeigen/" class="all-listings-link">
          Alle Anzeigen <Icon name="arrow" size={17} />
        </a>
      </div>
      <div data-ui="listing-grid" class="related-grid">
        {related.map((item) => (
          <ListingCard listing={item} />
        ))}
      </div>
    </section>
  </main>
  <dialog
    id="contact-dialog"
    class="contact-dialog"
    aria-labelledby="contact-heading"
    aria-describedby="contact-description"
  >
    <button
      class="close-dialog"
      data-close-dialog
      aria-label="Kontaktfenster schließen"
    >
      <Icon name="close" size={18} />
    </button>
    <div class="dialog-icon">
      <Icon name="chat" size={27} />
    </div>
    <div class="dialog-eyebrow">Ganz persönlich</div>
    <h2 id="contact-heading">Schreib mir einfach auf WhatsApp.</h2>
    <p id="contact-description">
      Du findest mich als @glup3 auf WhatsApp. Sag mir, welches Stück dich
      interessiert, und wir besprechen alles Weitere.
    </p>
    <div class="message-preview">
      <label for="contact-message">Deine Nachricht könnte so aussehen</label>
      <textarea id="contact-message" readonly rows="3">{message}</textarea>
    </div>
    <a class="whatsapp-button" href="https://wa.me/glup3">
      <Icon name="chat" size={17} />
      WhatsApp öffnen
      <Icon name="arrow" size={17} />
    </a>
    <button class="copy-button" id="copy-message">
      <Icon name="copy" size={17} />
      <span>Nachricht kopieren</span>
    </button>
    <p
      class="copy-status"
      id="copy-status"
      role="status"
      aria-live="polite"
    ></p>
  </dialog>
</Layout>
<script>
  document.querySelector('#share-listing')?.addEventListener('click', async () => {
    const status = document.querySelector('#share-status')!;
    const url = new URL(location.pathname, location.origin).href;
    try {
      if (navigator.share) await navigator.share({ title: document.title, url });
      else { await navigator.clipboard.writeText(url); status.textContent = 'Link kopiert – teile ihn mit deinen Freunden.'; }
    } catch (error) {
      if (error instanceof Error && error.name === 'AbortError') return;
      status.textContent = `Link zum Kopieren: ${url}`;
    }
  });
  document.querySelector<HTMLButtonElement>('#last-price-button')?.addEventListener('click', event => {
    const button = event.currentTarget as HTMLButtonElement;
    const reply = document.querySelector<HTMLElement>('#last-price-reply')!;
    reply.hidden = !reply.hidden;
    button.setAttribute('aria-expanded', String(!reply.hidden));
  });
  const contact = document.querySelector<HTMLDialogElement>('#contact-dialog')!;
  document.querySelector('#contact-button')!.addEventListener('click', () => { document.querySelector('#copy-status')!.textContent = ''; contact.showModal(); });
  for (const dialog of [contact]) {
    dialog.querySelector('[data-close-dialog]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => { const rect = dialog.getBoundingClientRect(); if (event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) dialog.close(); });
  }
  document.querySelector('#copy-message')!.addEventListener('click', async () => {
    const textarea = document.querySelector<HTMLTextAreaElement>('#contact-message')!;
    const status = document.querySelector('#copy-status')!;
    try { await navigator.clipboard.writeText(textarea.value); status.textContent = 'Kopiert! Jetzt in unserem WhatsApp-Chat einfügen.'; }
    catch { textarea.focus(); textarea.select(); status.textContent = 'Markiert – kopiere den Text und füge ihn in WhatsApp ein.'; }
  });
</script>

<style>
  .listing-page {
    margin-inline: auto;
    width: min(1440px, calc(100% - 2 * var(--page-gutter)));
    max-width: 1180px;
    padding-top: 24px;
    @media (width < 760px) {
      padding-top: 14px;
    }
  }
  .breadcrumbs {
    margin-bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    @media (width < 760px) {
      margin-bottom: 12px;
      font-size: 11px;
    }
    & a:hover {
      color: var(--color-brand-dark);
    }
    & :global(svg) {
      width: 10px;
      color: var(--color-muted);
    }
  }
  .title-row {
    margin-bottom: 4px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    @media (width < 760px) {
      flex-wrap: wrap;
      gap: 8px;
    }
    & h1 {
      min-width: 0;
      overflow-wrap: anywhere;
    }
    @media (width < 760px) {
      & h1 {
        width: 100%;
        font-size: 23px;
      }
    }
  }
  .detail-actions {
    display: flex;
    flex-shrink: 0;
    gap: 8px;
    @media (width < 760px) {
      margin-bottom: 6px;
    }
  }
  .share-button {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border-radius: var(--radius-ui);
    border: 1px solid var(--color-brand);
    background-color: white;
    padding-inline: 10px;
    padding-block: 6px;
    font-size: 12px;
    color: var(--color-brand-dark);
    &:hover {
      background-color: #eaf8ff;
    }
    height: 34px;
    width: 34px;
    padding: 5px;
  }
  .share-label {
    display: none;
  }
  .listing-meta {
    margin-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    color: var(--color-muted);
    @media (width < 760px) {
      font-size: 11px;
    }
  }
  .share-status {
    font-size: 12px;
    overflow-wrap: anywhere;
    color: var(--color-brand-dark);
    &:not(:empty) {
      margin-block: 10px;
    }
  }
  .detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: flex-start;
    column-gap: 16px;
    row-gap: 0;
    @media (width < 760px) {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
  .detail-info {
    grid-column: 2;
    grid-row: 1 / span 4;
    align-self: flex-start;
    border-radius: var(--radius-ui);
    border: 1px solid var(--color-line);
    background-color: var(--color-panel);
    padding: 16px;
    @media (width < 760px) {
      grid-column: 1;
      grid-row: auto;
      margin-top: 20px;
      min-height: 0;
    }
  }
  .detail-price small {
    margin-top: 4px;
    display: block;
    font-size: 12px;
    color: var(--color-muted);
  }
  .detail-price strong {
    display: block;
    font-size: 28px;
    line-height: 1.2;
    color: var(--color-brand);
  }
  .availability {
    margin-bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #3b7660;
    &[data-status="reserved"] {
      color: #97651c;
    }
    &[data-status="sold"] {
      color: var(--color-muted);
    }
    margin-top: 12px;
  }
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background-color: currentcolor;
  }
  .reserved-notice {
    margin-inline: 0;
    margin-block: 12px;
    background-color: #fff4df;
    padding: 10px;
    font-size: 12px;
  }
  .sold-notice {
    margin-inline: 0;
    margin-block: 12px;
    background-color: #e9edf5;
    padding: 10px;
    font-size: 12px;
  }
  .contact-button,
  .whatsapp-button,
  .copy-button {
    display: inline-flex;
    min-height: 40px;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--radius-ui);
    border: 1px solid transparent;
    padding-inline: 16px;
    padding-block: 9px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
  }
  .contact-button {
    min-height: 48px;
    &:disabled {
      background-color: #dce3ee;
      color: #65758f;
    }
  }
  .contact-button,
  .whatsapp-button {
    background-color: var(--color-brand);
    color: white;
    &:hover {
      background-color: var(--color-brand-dark);
    }
  }
  .contact-hint {
    margin-top: 8px;
    font-size: 11px;
    color: var(--color-muted);
  }
  .seller {
    margin-inline: 0;
    margin-block: 14px;
    margin-top: 16px;
    margin-bottom: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 12px;
    & small {
      margin-top: 3px;
      display: block;
      font-size: 11px;
      color: var(--color-muted);
    }
    & strong {
      display: block;
      font-size: 16px;
      font-weight: 600;
    }
  }
  .seller-avatar {
    display: grid;
    height: 40px;
    width: 40px;
    place-items: center;
    border-radius: 9999px;
    background-color: #e8edf6;
    color: #94a2bc;
  }
  .last-price {
    margin-top: 16px;
    font-size: 12px;
    & button {
      padding-inline: 0;
      padding-block: 8px;
    }
    & p {
      margin-top: 4px;
    }
  }
  .last-price-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: transparent;
    background-image: none;
    font-size: 13px;
    color: var(--color-brand-dark);
    &:hover {
      text-decoration-line: underline;
    }
  }
  .specs-section {
    grid-column: 1;
    margin-top: 24px;
    & h2 {
      margin-bottom: 16px;
      font-size: 20px;
      font-weight: 400;
    }
  }
  .specs {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
    row-gap: 12px;
    padding: 0;
    & > div {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding-inline: 0;
      padding-block: 8px;
    }
    & dd {
      margin: 0;
      font-size: 14px;
    }
    & dt {
      font-size: 12px;
      color: var(--color-muted);
    }
  }
  .description-section {
    grid-column: 1;
    margin-top: 28px;
    & h2 {
      margin-bottom: 16px;
      font-size: 20px;
      font-weight: 400;
    }
    & p {
      margin-bottom: 14px;
      max-width: 70ch;
      font-size: 14px;
      line-height: 1.8;
    }
  }
  .personal-note {
    grid-column: 1;
    margin-top: 16px;
    display: flex;
    gap: 12px;
    border: 1px solid var(--color-line);
    background-color: var(--color-panel);
    padding: 14px;
    font-size: 12px;
    line-height: 1.7;
    & :global(svg) {
      color: var(--color-muted);
    }
  }
  .related-section {
    margin-block: 32px;
    padding-top: 24px;
  }
  .related-heading {
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    @media (width < 760px) {
      flex-wrap: wrap;
    }
    & h2 {
      font-size: 18px;
      font-weight: 400;
    }
  }
  .all-listings-link {
    display: inline-flex;
    transform-origin: right center;
    align-items: center;
    gap: 6px;
    background-color: transparent;
    background-image: none;
    font-size: 13px;
    color: var(--color-brand-dark);
    transition: transform 150ms ease-out;
    &:hover {
      text-decoration-line: underline;
    }
    @media (hover: hover) {
      &:hover {
        transform: scale(1.06);
      }
    }
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 260px));
    justify-content: flex-start;
    gap: 20px;
    @media (width < 760px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    &[data-view="list"] {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    @media (width < 760px) {
      &[data-view="list"] {
        margin-inline: -16px;
      }
      :global([data-ui~="related-section"]) & {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  }
  .contact-dialog {
    position: fixed;
    margin: auto;
    max-height: calc(100dvh - 40px);
    width: min(460px, calc(100% - 32px));
    overflow: auto;
    border-radius: var(--radius-ui);
    border: 1px solid var(--color-line);
    background-color: white;
    padding: 30px;
    color: var(--color-ink);
    box-shadow: 0 12px 50px #0003;
    & > p {
      font-size: 13px;
      line-height: 1.7;
    }
    & h2 {
      margin-bottom: 14px;
      font-size: 23px;
    }
    &::backdrop {
      background-color: #17233b99;
    }
  }
  .close-dialog {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
    height: 36px;
    width: 36px;
    place-items: center;
    border-radius: var(--radius-ui);
    background-color: var(--color-panel);
    color: var(--color-muted);
  }
  .dialog-icon {
    margin-bottom: 14px;
    color: var(--color-brand);
  }
  .dialog-eyebrow {
    margin-bottom: 10px;
    font-size: 12px;
    color: var(--color-muted);
  }
  .message-preview {
    margin-inline: 0;
    margin-top: 20px;
    margin-bottom: 16px;
    border-radius: var(--radius-ui);
    border: 1px solid var(--color-line);
    background-color: var(--color-panel);
    padding: 14px;
    & label {
      margin-bottom: 8px;
      display: block;
      font-size: 11px;
      color: var(--color-muted);
      text-transform: uppercase;
    }
    & textarea {
      display: block;
      min-height: 95px;
      width: 100%;
      resize: vertical;
      border-style: solid;
      border-width: 0;
      background-color: transparent;
      font-size: 13px;
      line-height: 1.7;
      color: var(--color-ink);
    }
  }
  .whatsapp-button,
  .copy-button {
    margin-bottom: 10px;
  }
  .copy-button {
    border-color: var(--color-brand);
    background-color: white;
    color: var(--color-brand-dark);
    &:hover {
      background-color: #eaf8ff;
    }
  }
  .copy-status {
    min-height: 20px;
    font-size: 12px;
  }
</style>
