---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Was letzte Seite? – Meinhaben">
  <main id="main" class="not-found-page">
    <div class="not-found-label">404 · Schon weg?</div>
    <h1>Was letzte Seite?</h1>
    <p>
      Dieser Artikel wurde leider gerade verkauft. An wen, der nicht verhandelt
      hat.
    </p>
    <p>
      Oder der Link stimmt einfach nicht. Bei den anderen Dingen wirst du
      bestimmt fündig.
    </p>
    <a href="/" class="browse-link">
      Zurück zum Stöbern <Icon name="arrow" size={18} />
    </a>
  </main>
</Layout>

<style>
  .not-found-page {
    margin-inline: auto;
    width: min(1440px, calc(100% - 2 * var(--page-gutter)));
    padding-top: 80px;
    padding-bottom: 100px;
    text-align: center;
    & p {
      margin-inline: auto;
      margin-block: 20px;
      max-width: 460px;
      line-height: 1.8;
    }
  }
  .not-found-label {
    margin-bottom: 10px;
    font-size: 12px;
    color: var(--color-muted);
  }
  .browse-link {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--radius-ui);
    border: 1px solid transparent;
    background-color: var(--color-brand);
    padding-inline: 16px;
    padding-block: 9px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    color: white;
    &:hover {
      background-color: var(--color-brand-dark);
    }
  }
</style>
