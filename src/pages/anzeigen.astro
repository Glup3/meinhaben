---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import { getListings, getCategories } from '../data/listings';
const [listings, categoryRecords] = await Promise.all([getListings(), getCategories()]);
const conditions = [...new Set(listings.map(item => item.condition))];
const categories = categoryRecords.map(category => category.name).filter(category => listings.some(item => item.category === category));
---
<Layout title="Anzeigen suchen – Meinhaben">
  <main id="main" class="w-[min(1440px,_calc(100%_-_2_*_var(--page-gutter)))] mx-auto pt-4.25 max-[760px]:pt-0">
    <section class="scroll-mt-4 pt-4 max-[760px]:pt-6" id="dinge" aria-labelledby="listings-heading">
      <div class="search-panel">
        <div class="search-heading">
          <div>
            <p class="search-eyebrow">Stöbern. Finden. Freuen.</p>
            <h1>Was suchst du?</h1>
          </div>
          <span class="inventory-count">{listings.length} Anzeigen</span>
        </div>
        <form role="search" id="listing-search-form">
          <label class="sr-only" for="listing-search">Anzeigen durchsuchen</label>
          <div class="search-field">
            <Icon name="search" size={22} />
            <input id="listing-search" name="q" type="search" placeholder="Titel, Kategorie oder Stichwort …" autocomplete="off" aria-controls="listing-grid" />
            <button class="search-submit" type="submit">Suchen<Icon name="right" size={17} /></button>
          </div>
        </form>
        <div class="filter-toolbar">
          <div class="category-chips" role="group" aria-label="Nach Kategorie filtern">
            <button class="category-chip" data-category-filter="all" aria-pressed="true">Alle<span>{listings.length}</span></button>
            {categories.map(category => <button class="category-chip" data-category-filter={category} aria-pressed="false"><Icon name={categoryRecords.find(record => record.name === category)?.icon || 'box'} size={17} />{category}<span>{listings.filter(item => item.category === category).length}</span></button>)}
          </div>
          <details data-additional-filters class="additional-filters">
            <summary><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h7m6 0h3M4 17h3m6 0h7" /><circle cx="14" cy="7" r="3" /><circle cx="10" cy="17" r="3" /></svg>Weitere Filter<span class="filter-chevron"><Icon name="right" size={15} /></span></summary>
            <div class="filter-fields">
              <label class="filter-field">Zustand<select id="condition"><option value="all">Alle Zustände</option>{conditions.map(condition => <option value={condition}>{condition}</option>)}</select></label>
              <label class="filter-field">Preis bis<div class="price-input"><input id="max-price" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Alle Preise" /><span>€</span></div></label>
              <label class="availability-filter"><input type="checkbox" id="available-only" /><span class="availability-switch" aria-hidden="true"></span>Nur verfügbare Anzeigen</label>
              <button class="free-filter" id="free-only" aria-pressed="false"><Icon name="gift" size={18} />Zu verschenken<Icon name="check" size={16} class="free-check" /></button>
            </div>
          </details>
        </div>
      </div>
      <div class="results-heading">
        <h2 id="listings-heading" tabindex="-1">Anzeigen <span id="result-count" role="status" aria-live="polite">({listings.length})</span></h2>
      </div>
      <div class="pt-1.25 px-2 pb-3 text-muted text-[12px] wrap-anywhere pl-0" id="active-search" hidden><span id="search-summary"></span></div>
      <div data-ui="listing-grid" class="grid grid-cols-[repeat(auto-fill,_minmax(min(100%,_230px),_260px))] gap-5 justify-start max-[760px]:grid-cols-2 max-[760px]:gap-3 max-[760px]:[[data-ui~=related-section]_&]:grid-cols-2" id="listing-grid">{listings.map((listing, index) => <ListingCard listing={listing} eager={index < 3} />)}</div>
      <div class="py-10 px-5 text-center bg-panel [&_>_svg]:text-muted [&_>_svg]:mb-3 [&_h3]:text-[18px] [&_p]:mt-3 [&_p]:mx-0 [&_p]:mb-5 [&_p]:leading-[1.6]" id="empty-state" hidden><Icon name="search" size={30} /><h3>Keine Anzeigen gefunden</h3><p>Versuche einen anderen Suchbegriff oder passe deine Filter an.</p><button class="inline-flex justify-center items-center gap-2 min-h-10 py-2.25 px-4 border border-transparent rounded-ui font-bold text-[14px] text-center bg-brand text-white [&:hover]:bg-brand-dark [[data-ui~=vertical-copy]_&]:bg-[#093d96] [[data-ui~=vertical-copy]_&]:text-white [[data-ui~=vertical-copy]_&]:mt-7 [[data-ui~=search-entry]_&]:min-h-11 max-[480px]:[[data-ui~=search-entry]_&]:px-3" id="reset-filters">Alle Anzeigen</button></div>
      <p class="text-center text-muted text-[12px] mx-0 mb-8 mt-6">Alle Anzeigen gesehen. Was dabei? Dann meld dich.</p>
    </section>
  </main>
</Layout>
<script>
  const search = document.querySelector<HTMLInputElement>('#listing-search')!;
  const available = document.querySelector<HTMLInputElement>('#available-only')!;
  const grid = document.querySelector<HTMLElement>('#listing-grid')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-listing]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
  const maxPrice = document.querySelector<HTMLInputElement>('#max-price')!;
  const condition = document.querySelector<HTMLSelectElement>('#condition')!;
  const freeButton = document.querySelector<HTMLButtonElement>('#free-only')!;
  let freeOnly = false;
  let category = 'all';
  const normalize = (value: string) => value.toLocaleLowerCase('de-AT').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ß/g, 'ss');
  function update() {
    const terms = normalize(search.value.trim()).split(/\s+/).filter(Boolean);
    const budget = maxPrice.value !== '' && Number.isFinite(maxPrice.valueAsNumber) && maxPrice.valueAsNumber >= 0 ? maxPrice.valueAsNumber : Infinity;
    const filtered = !!(terms.length || category !== 'all' || available.checked || freeOnly || budget !== Infinity || condition.value !== 'all');
    let count = 0;
    cards.forEach(card => {
      const matches = (!freeOnly || Number(card.dataset.price) === 0) && Number(card.dataset.price) <= budget && (condition.value === 'all' || card.dataset.condition === condition.value) && (category === 'all' || card.dataset.category === category) && (!available.checked || card.dataset.status === 'available') && terms.every(term => normalize(card.dataset.search || '').includes(term));
      card.hidden = !matches;
      if (matches) count++;
    });
    [...cards].sort((a, b) => (b.dataset.date || '').localeCompare(a.dataset.date || '')).forEach(card => grid.append(card));
    document.querySelector('#result-count')!.textContent = `(${count})`;
    document.querySelector<HTMLElement>('#empty-state')!.hidden = count > 0;
    document.querySelector<HTMLElement>('#active-search')!.hidden = !filtered;
    document.querySelector('#search-summary')!.textContent = [search.value.trim() ? `„${search.value.trim()}“` : '', category !== 'all' ? category : '', freeOnly ? 'Zu verschenken' : '', budget !== Infinity ? `Bis € ${budget.toLocaleString('de-AT')}` : '', condition.value !== 'all' ? condition.value : '', available.checked ? 'Nur verfügbar' : ''].filter(Boolean).join(' · ');
    freeButton.setAttribute('aria-pressed', String(freeOnly));
    const params = new URLSearchParams();
    if (freeOnly) params.set('gratis', '1');
    if (budget !== Infinity) params.set('budget', String(budget));
    if (condition.value !== 'all') params.set('zustand', condition.value);
    if (search.value.trim()) params.set('q', search.value.trim());
    if (category !== 'all') params.set('kategorie', category);
    if (available.checked) params.set('verfuegbar', '1');
    history.replaceState(null, '', `${location.pathname}${params.size ? '?' + params.toString() : ''}${location.hash}`);
  }
  function setCategory(value: string) { category = value; chips.forEach(chip => { const active = chip.dataset.categoryFilter === category; chip.setAttribute('aria-pressed', String(active)); }); }
  function restore() {
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') || '';
    freeOnly = params.get('gratis') === '1';
    const budget = params.get('budget');
    maxPrice.value = budget !== null && budget.trim() !== '' && Number.isFinite(Number(budget)) && Number(budget) >= 0 ? String(Number(budget)) : '';
    condition.value = [...condition.options].some(option => option.value === params.get('zustand')) ? params.get('zustand')! : 'all';
    const initialCategory = params.get('kategorie') || 'all';
    setCategory(chips.some(chip => chip.dataset.categoryFilter === initialCategory) ? initialCategory : 'all');
    available.checked = params.get('verfuegbar') === '1';
    document.querySelector<HTMLDetailsElement>('[data-additional-filters]')!.open = freeOnly || maxPrice.value !== '' || condition.value !== 'all' || available.checked;
    update();
  }
  function resetFilters() {
    search.value = ''; setCategory('all'); available.checked = false;
    freeOnly = false; maxPrice.value = ''; condition.value = 'all'; update();
  }
  search.addEventListener('input', update);
  document.querySelector('#listing-search-form')!.addEventListener('submit', event => { event.preventDefault(); update(); document.querySelector<HTMLElement>('#listings-heading')!.focus({ preventScroll: true }); });
  freeButton.addEventListener('click', () => { freeOnly = !freeOnly; update(); });
  maxPrice.addEventListener('input', update);
  condition.addEventListener('change', update);
  chips.forEach(chip => chip.addEventListener('click', () => { setCategory(chip.dataset.categoryFilter!); update(); document.querySelector<HTMLElement>('#listings-heading')!.focus({ preventScroll: true }); document.querySelector('#dinge')!.scrollIntoView({ behavior: 'smooth', block: 'start' }); }));
  available.addEventListener('change', update);

  document.querySelector('#reset-filters')!.addEventListener('click', resetFilters);
  window.addEventListener('pageshow', restore);
  window.addEventListener('popstate', restore);
  restore();
</script>

<style>
  .search-panel {
    padding: 28px;
    margin-bottom: 30px;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background: linear-gradient(120deg, #f2faff, #f7f9fd 65%, #fff);
  }
  .search-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  .search-eyebrow { margin-bottom: 6px; font-size: 12px; font-weight: 600; letter-spacing: .04em; color: var(--color-brand-dark); }
  .search-heading h1 { font-size: clamp(24px, 3vw, 32px); font-weight: 700; letter-spacing: -.035em; color: #16324f; }
  .inventory-count { flex-shrink: 0; padding: 7px 12px; border: 1px solid #dceaf3; border-radius: 30px; background: #ffffffb3; color: var(--color-muted); font-size: 12px; }
  .search-field { display: flex; align-items: center; gap: 14px; padding: 7px 7px 7px 18px; border: 1px solid #d5e2ed; border-radius: 14px; background: white; color: var(--color-muted); box-shadow: 0 3px 12px #16324f05; transition: border-color 150ms, box-shadow 150ms; }
  .search-field:focus-within { border-color: var(--color-brand); box-shadow: 0 0 0 3px #00a4e812; }
  .search-field input { width: 100%; min-width: 0; flex: 1; min-height: 44px; border: 0; background: transparent; color: var(--color-ink); font-size: 15px; }
  .search-field input:focus-visible { outline: none; }
  .search-field input::placeholder { color: #7a899b; opacity: 1; }
  .search-submit { display: inline-flex; align-items: center; justify-content: center; gap: 16px; min-height: 46px; padding: 0 22px; border-radius: 10px; background: var(--color-brand); color: white; font-weight: 700; transition: background 150ms; }
  .search-submit:hover { background: var(--color-brand-dark); }
  .filter-toolbar { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 12px 20px; margin-top: 18px; }
  .category-chips { display: flex; flex-wrap: wrap; gap: 8px; flex: 1; }
  .category-chip { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 42px; padding: 0 14px; border: 1px solid transparent; border-radius: 30px; background: #fff; color: #52647a; font-size: 13px; font-weight: 600; transition: background 150ms, border-color 150ms; }
  .category-chip span { display: grid; place-items: center; min-width: 22px; height: 22px; padding: 0 5px; border-radius: 20px; background: #eef2f7; color: #65758b; font-size: 11px; }
  .category-chip:hover { border-color: #c1d9e9; background: #f0f8fd; }
  .category-chip[aria-pressed=true] { background: #163f65; color: white; }
  .category-chip[aria-pressed=true] span { background: #ffffff24; color: white; }
  .additional-filters { display: contents; }
  .additional-filters summary { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 42px; padding: 0 14px; border: 1px solid #d5e2ed; border-radius: 30px; color: #405773; font-size: 13px; font-weight: 600; cursor: pointer; list-style: none; }
  .additional-filters summary::-webkit-details-marker { display: none; }
  .additional-filters summary:hover { background: white; }
  .filter-chevron { display: flex; transform: rotate(90deg); transition: transform 150ms; }
  .additional-filters[open] .filter-chevron { transform: rotate(-90deg); }
  .additional-filters[open] summary { border-color: #afcedf; background: white; }
  .filter-fields { width: 100%; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px 20px; padding-top: 20px; margin-top: 4px; border-top: 1px solid #dce6ee; }
  .filter-field { display: grid; gap: 8px; flex: 1 1 180px; max-width: 260px; font-size: 12px; font-weight: 600; color: #52647a; }
  .filter-field select, .price-input { width: 100%; min-height: 46px; padding: 0 12px; border: 1px solid #d5e2ed; border-radius: 10px; background: white; color: var(--color-ink); font-size: 14px; font-weight: 400; }
  .price-input { display: flex; align-items: center; gap: 8px; }
  .price-input input { width: 100%; min-width: 0; min-height: 44px; padding: 0; border: 0; background: transparent; }
  .price-input:focus-within { outline: 2px solid var(--color-navy); outline-offset: 3px; }
  .price-input input:focus-visible { outline: none; }
  .price-input span { color: var(--color-muted); }
  .availability-filter { position: relative; display: flex; align-items: center; gap: 10px; min-height: 46px; font-size: 13px; cursor: pointer; }
  .availability-filter input { position: absolute; width: 38px; height: 24px; margin: 0; opacity: 0; cursor: pointer; }
  .availability-switch { width: 38px; height: 24px; padding: 3px; border-radius: 20px; background: #c7d2df; transition: background 150ms; }
  .availability-switch::after { content: ''; display: block; width: 18px; height: 18px; border-radius: 50%; background: white; box-shadow: 0 1px 3px #16324f20; transition: transform 150ms; }
  .availability-filter input:checked + .availability-switch { background: var(--color-brand-dark); }
  .availability-filter input:checked + .availability-switch::after { transform: translateX(14px); }
  .availability-filter input:focus-visible + .availability-switch { outline: 2px solid var(--color-navy); outline-offset: 3px; }
  .free-filter { display: flex; align-items: center; justify-content: center; gap: 9px; min-height: 46px; padding: 0 14px; border: 1px solid #d5e2ed; border-radius: 10px; background: white; color: #52647a; font-size: 13px; }
  .free-filter:hover { border-color: #9cbfd3; }
  .free-filter[aria-pressed=true] { border-color: #92cbb6; background: #eaf7f0; color: #25664a; }
  .free-filter :global(.free-check) { opacity: 0; }
  .free-filter[aria-pressed=true] :global(.free-check) { opacity: 1; }
  .results-heading { margin-bottom: 18px; }
  .results-heading h2 { font-size: 18px; color: #16324f; }
  .results-heading span { margin-left: 4px; color: var(--color-muted); font-size: 14px; font-weight: 400; }
  @media (max-width: 760px) {
    .search-panel { padding: 20px; border-radius: 16px; margin-bottom: 24px; }
    .search-heading { margin-bottom: 18px; }
    .search-eyebrow { font-size: 11px; }
    .search-field { gap: 10px; padding-left: 12px; }
    .search-field input { font-size: 14px; }
    .search-submit { gap: 6px; padding: 0 14px; }
    .category-chips { flex-basis: 100%; }
    .category-chip { padding: 0 12px; }
    .filter-field { max-width: none; }
    .filter-toolbar { gap: 14px; }
  }
  @media (max-width: 480px) {
    .search-panel { padding: 16px; }
    .inventory-count { padding: 6px 9px; font-size: 11px; }
    .search-field { gap: 8px; }
    .search-field input { font-size: 13px; }
    .search-submit { padding: 0 12px; font-size: 13px; }
    .search-submit :global(svg) { display: none; }
    .category-chip { gap: 6px; font-size: 12px; }
    .filter-field { flex-basis: calc(50% - 10px); min-width: 0; }
    .availability-filter, .free-filter { width: 100%; justify-content: flex-start; }
  }
</style>
