---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import { getListings, getCategories } from '../data/listings';
const [listings, categoryRecords] = await Promise.all([getListings(), getCategories()]);
const conditions = [...new Set(listings.map(item => item.condition))];
const categories = categoryRecords.map(category => category.name).filter(category => listings.some(item => item.category === category));
---
<Layout title="Anzeigen suchen – Meinhaben">
  <main id="main" class="page-container home-main results-main">
    <div class="marketplace-title"><h1>Anzeigen suchen</h1><span>{listings.length} Anzeigen</span></div>
    <section class="listings-section" id="dinge" aria-labelledby="listings-heading">
      <form class="results-search" role="search" id="listing-search-form">
        <label for="listing-search">Was suchst du?</label>
        <div class="search-entry"><Icon name="search" size={20} /><input id="listing-search" name="q" type="search" placeholder="Titel, Kategorie oder Stichwort" autocomplete="off" aria-controls="listing-grid" /><button class="button primary" type="submit">Suchen</button></div>
      </form>
      <div class="browse-filters">
        <div class="category-filters" role="group" aria-label="Nach Kategorie filtern"><button class="filter-chip active" data-category-filter="all" aria-pressed="true">Alle<span>{listings.length}</span></button>{categories.map(category => <button class="filter-chip" data-category-filter={category} aria-pressed="false">{category}<span>{listings.filter(item => item.category === category).length}</span></button>)}</div>
        <details class="additional-filters"><summary>Weitere Filter</summary><div class="filter-options">
          <label class="condition-control">Zustand<select id="condition"><option value="all">Alle Zustände</option>{conditions.map(condition => <option value={condition}>{condition}</option>)}</select></label>
          <label class="price-control">Preis bis (€)<input id="max-price" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Alle Preise" /></label>
          <label class="availability-toggle"><input type="checkbox" id="available-only" />Nur verfügbare Anzeigen</label><button class="quick-filter" id="free-only" aria-pressed="false"><Icon name="box" size={17} />Zu verschenken</button>
        </div></details>
      </div>
      <div class="results-toolbar">
        <h2 id="listings-heading" tabindex="-1">Anzeigen <span id="result-count" role="status" aria-live="polite">({listings.length})</span></h2>
        <div class="result-controls"><button id="clear-search">Zurücksetzen</button><label class="sort-label"><span class="sr-only">Sortieren nach</span><select id="sort"><option value="newest">Neueste zuerst</option><option value="price-asc">Preis aufsteigend</option><option value="price-desc">Preis absteigend</option></select></label><div class="view-switch" role="group" aria-label="Darstellung"><button data-view="grid" aria-label="Rasteransicht" aria-pressed="true"><Icon name="grid" size={18} /></button><button data-view="list" aria-label="Listenansicht" aria-pressed="false"><Icon name="list" size={20} /></button></div></div>
      </div>
      <div class="active-search" id="active-search" hidden><span id="search-summary"></span></div>
      <div class="listing-grid" id="listing-grid">{listings.map((listing, index) => <ListingCard listing={listing} eager={index < 3} />)}</div>
      <div class="empty-state" id="empty-state" hidden><Icon name="search" size={30} /><h3>Keine Anzeigen gefunden</h3><p>Versuche einen anderen Suchbegriff oder passe deine Filter an.</p><button class="button primary" id="reset-filters">Alle Anzeigen</button></div>
      <p class="listing-end">Alle Anzeigen gesehen. Was dabei? Dann meld dich.</p>
    </section>
  </main>
</Layout>
<script>
  const search = document.querySelector<HTMLInputElement>('#listing-search')!;
  const available = document.querySelector<HTMLInputElement>('#available-only')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort')!;
  const grid = document.querySelector<HTMLElement>('#listing-grid')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-listing]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
  const maxPrice = document.querySelector<HTMLInputElement>('#max-price')!;
  const condition = document.querySelector<HTMLSelectElement>('#condition')!;
  const freeButton = document.querySelector<HTMLButtonElement>('#free-only')!;
  let freeOnly = false;
  let category = 'all';
  const normalize = (value: string) => value.toLocaleLowerCase('de-AT').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ß/g, 'ss');
  function update() {
    const terms = normalize(search.value.trim()).split(/\s+/).filter(Boolean);
    const budget = maxPrice.value !== '' && Number.isFinite(maxPrice.valueAsNumber) && maxPrice.valueAsNumber >= 0 ? maxPrice.valueAsNumber : Infinity;
    const filtered = !!(terms.length || category !== 'all' || available.checked || freeOnly || budget !== Infinity || condition.value !== 'all');
    let count = 0;
    cards.forEach(card => {
      const matches = (!freeOnly || Number(card.dataset.price) === 0) && Number(card.dataset.price) <= budget && (condition.value === 'all' || card.dataset.condition === condition.value) && (category === 'all' || card.dataset.category === category) && (!available.checked || card.dataset.status === 'available') && terms.every(term => normalize(card.dataset.search || '').includes(term));
      card.hidden = !matches;
      if (matches) count++;
    });
    [...cards].sort((a, b) => sort.value === 'price-asc' ? Number(a.dataset.price) - Number(b.dataset.price) : sort.value === 'price-desc' ? Number(b.dataset.price) - Number(a.dataset.price) : (b.dataset.date || '').localeCompare(a.dataset.date || '')).forEach(card => grid.append(card));
    document.querySelector('#result-count')!.textContent = `(${count})`;
    document.querySelector<HTMLElement>('#empty-state')!.hidden = count > 0;
    document.querySelector<HTMLElement>('#active-search')!.hidden = !filtered;
    document.querySelector('#search-summary')!.textContent = [search.value.trim() ? `„${search.value.trim()}“` : '', category !== 'all' ? category : '', freeOnly ? 'Zu verschenken' : '', budget !== Infinity ? `Bis € ${budget.toLocaleString('de-AT')}` : '', condition.value !== 'all' ? condition.value : '', available.checked ? 'Nur verfügbar' : ''].filter(Boolean).join(' · ');
    freeButton.setAttribute('aria-pressed', String(freeOnly));
    const params = new URLSearchParams();
    if (freeOnly) params.set('gratis', '1');
    if (budget !== Infinity) params.set('budget', String(budget));
    if (condition.value !== 'all') params.set('zustand', condition.value);
    if (search.value.trim()) params.set('q', search.value.trim());
    if (category !== 'all') params.set('kategorie', category);
    if (available.checked) params.set('verfuegbar', '1');
    if (sort.value !== 'newest') params.set('sortierung', sort.value);
    history.replaceState(null, '', `${location.pathname}${params.size ? '?' + params.toString() : ''}${location.hash}`);
  }
  function setCategory(value: string) { category = value; chips.forEach(chip => { const active = chip.dataset.categoryFilter === category; chip.classList.toggle('active', active); chip.setAttribute('aria-pressed', String(active)); }); }
  function restore() {
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') || '';
    freeOnly = params.get('gratis') === '1';
    const budget = params.get('budget');
    maxPrice.value = budget !== null && budget.trim() !== '' && Number.isFinite(Number(budget)) && Number(budget) >= 0 ? String(Number(budget)) : '';
    condition.value = [...condition.options].some(option => option.value === params.get('zustand')) ? params.get('zustand')! : 'all';
    const initialCategory = params.get('kategorie') || 'all';
    setCategory(chips.some(chip => chip.dataset.categoryFilter === initialCategory) ? initialCategory : 'all');
    available.checked = params.get('verfuegbar') === '1';
    sort.value = ['price-asc', 'price-desc'].includes(params.get('sortierung') || '') ? params.get('sortierung')! : 'newest';
    document.querySelector<HTMLDetailsElement>('.additional-filters')!.open = freeOnly || maxPrice.value !== '' || condition.value !== 'all' || available.checked;
    update();
  }
  function resetFilters() {
    search.value = ''; setCategory('all'); available.checked = false; sort.value = 'newest';
    freeOnly = false; maxPrice.value = ''; condition.value = 'all'; update();
  }
  search.addEventListener('input', update);
  document.querySelector('#listing-search-form')!.addEventListener('submit', event => { event.preventDefault(); update(); document.querySelector<HTMLElement>('#listings-heading')!.focus({ preventScroll: true }); });
  freeButton.addEventListener('click', () => { freeOnly = !freeOnly; update(); });
  maxPrice.addEventListener('input', update);
  condition.addEventListener('change', update);
  chips.forEach(chip => chip.addEventListener('click', () => { setCategory(chip.dataset.categoryFilter!); update(); document.querySelector<HTMLElement>('#listings-heading')!.focus({ preventScroll: true }); document.querySelector('#dinge')!.scrollIntoView({ behavior: 'smooth', block: 'start' }); }));
  document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button => button.addEventListener('click', () => {
    const list = button.dataset.view === 'list';
    grid.classList.toggle('list-view', list);
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(control => control.setAttribute('aria-pressed', String(control === button)));
  }));
  available.addEventListener('change', update);
  sort.addEventListener('change', update);

  document.querySelector('#clear-search')!.addEventListener('click', resetFilters);
  document.querySelector('#reset-filters')!.addEventListener('click', resetFilters);
  window.addEventListener('pageshow', restore);
  window.addEventListener('popstate', restore);
  restore();
</script>

<style>
  @reference "../styles/global.css";

  @layer components {
    .results-search { @apply mt-5 mx-0 mb-4; }
    .results-search > label { @apply block font-semibold mb-2; }
    .search-entry { @apply flex items-center gap-3 border border-line rounded-ui pt-1.5 pr-1.5 pb-1.5 pl-3.5 bg-white; }
    .search-entry input { @apply flex-1 w-full min-w-0 border-0 bg-transparent min-h-11; font: inherit; }
    .search-entry .button { @apply min-h-11; }
    .browse-filters { @apply mb-5; }
    .category-filters { @apply flex flex-wrap gap-2 p-0; }
    .filter-chip { @apply w-auto min-h-11 py-2 px-3 border border-line rounded-ui; }
    .filter-chip.active { @apply bg-panel border-brand; }
    .additional-filters { @apply mt-3; }
    .additional-filters summary { @apply cursor-pointer w-fit py-2.5 px-0 text-[14px] font-semibold; }
    .filter-options { @apply flex flex-wrap items-end gap-y-3 gap-x-5 py-3 px-0; }
    .condition-control, .price-control { @apply grid gap-1.5 text-[13px]; }
    .filter-options select, .price-control input { @apply min-h-11 max-w-55 border border-line rounded-ui p-2 bg-white; font: inherit; }
    .availability-toggle { @apply p-0 text-[13px]; }
    .quick-filter { @apply w-auto min-h-11 border border-line rounded-ui; }
    .results-toolbar { @apply flex-wrap pt-0 px-0 pb-3; }
    .results-toolbar h2 { @apply text-[20px]; }
    .result-controls { @apply flex flex-wrap items-center gap-3; }
    #clear-search { @apply bg-transparent text-brand-dark min-h-11 text-[13px]; }
    .sort-label select { @apply min-h-11 text-[13px]; }
    .view-switch button { @apply w-11 h-11 border border-line rounded-ui; }
    .view-switch button[aria-pressed=true] { @apply bg-panel; }
    .active-search { @apply pl-0; }
    .listing-end { @apply mt-6; }
    @media (max-width: 480px) { .search-entry { @apply gap-1.5; } .search-entry .button { @apply px-3; } .result-controls { @apply gap-2 w-full; } .sort-label { @apply ml-auto; } }
  }
</style>
