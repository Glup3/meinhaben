---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import { getListings, getCategories } from '../data/listings';
const [listings, categoryRecords] = await Promise.all([getListings(), getCategories()]);
const conditions = [...new Set(listings.map(item => item.condition))];
const categories = categoryRecords.map(category => category.name).filter(category => listings.some(item => item.category === category));
---
<Layout title="Anzeigen suchen – Meinhaben">
  <main id="main" class="w-[min(1440px,_calc(100%_-_2_*_var(--page-gutter)))] mx-auto pt-4.25 max-[760px]:pt-0">
    <div class="flex items-baseline gap-1.5 mb-2.5 [&_h1]:text-brand [&_h1]:text-[16px] [&_h1]:font-bold [&_>_span]:text-[14px] [&_>_span]:pl-1.5 max-[760px]:absolute max-[760px]:w-0.25 max-[760px]:h-0.25 max-[760px]:overflow-hidden max-[760px]:whitespace-nowrap max-[760px]:[clip-path:inset(100%)]"><h1>Anzeigen suchen</h1><span>{listings.length} Anzeigen</span></div>
    <section class="scroll-mt-4 pt-4 max-[760px]:pt-6" id="dinge" aria-labelledby="listings-heading">
      <form class="mt-5 mx-0 mb-4 [&_>_label]:block [&_>_label]:font-semibold [&_>_label]:mb-2" role="search" id="listing-search-form">
        <label for="listing-search">Was suchst du?</label>
        <div data-ui="search-entry" class="flex items-center gap-3 border border-line rounded-ui pt-1.5 pr-1.5 pb-1.5 pl-3.5 bg-white [&_input]:flex-1 [&_input]:w-full [&_input]:min-w-0 [&_input]:border-0 [&_input]:bg-transparent [&_input]:min-h-11 [&_input]:[font:inherit] max-[480px]:gap-1.5"><Icon name="search" size={20} /><input id="listing-search" name="q" type="search" placeholder="Titel, Kategorie oder Stichwort" autocomplete="off" aria-controls="listing-grid" /><button class="inline-flex justify-center items-center gap-2 min-h-10 py-2.25 px-4 border border-transparent rounded-ui font-bold text-[14px] text-center bg-brand text-white [&:hover]:bg-brand-dark [[data-ui~=vertical-copy]_&]:bg-[#093d96] [[data-ui~=vertical-copy]_&]:text-white [[data-ui~=vertical-copy]_&]:mt-7 [[data-ui~=search-entry]_&]:min-h-11 max-[480px]:[[data-ui~=search-entry]_&]:px-3" type="submit">Suchen</button></div>
      </form>
      <div class="mb-5">
        <div data-ui="category-filters" class="flex flex-wrap gap-2 p-0 max-[760px]:flex max-[760px]:overflow-x-auto max-[760px]:p-0 max-[760px]:gap-2" role="group" aria-label="Nach Kategorie filtern"><button class="flex gap-2 items-center bg-none bg-transparent text-[14px] text-left w-auto min-h-11 py-2 px-3 border border-line rounded-ui [&_span]:text-muted [&_span]:text-[12px] [&[aria-pressed=true]]:text-brand-dark [&[aria-pressed=true]]:font-bold [&[aria-pressed=true]]:bg-panel [&[aria-pressed=true]]:border-brand [&:hover]:underline max-[760px]:w-auto max-[760px]:whitespace-nowrap max-[760px]:shrink-0 max-[760px]:text-[12px] max-[760px]:min-h-11" data-category-filter="all" aria-pressed="true">Alle<span>{listings.length}</span></button>{categories.map(category => <button class="flex gap-2 items-center bg-none bg-transparent text-[14px] text-left w-auto min-h-11 py-2 px-3 border border-line rounded-ui [&_span]:text-muted [&_span]:text-[12px] [&[aria-pressed=true]]:text-brand-dark [&[aria-pressed=true]]:font-bold [&[aria-pressed=true]]:bg-panel [&[aria-pressed=true]]:border-brand [&:hover]:underline max-[760px]:w-auto max-[760px]:whitespace-nowrap max-[760px]:shrink-0 max-[760px]:text-[12px] max-[760px]:min-h-11" data-category-filter={category} aria-pressed="false">{category}<span>{listings.filter(item => item.category === category).length}</span></button>)}</div>
        <details data-additional-filters class="mt-3 [&_summary]:cursor-pointer [&_summary]:w-fit [&_summary]:py-2.5 [&_summary]:px-0 [&_summary]:text-[14px] [&_summary]:font-semibold"><summary>Weitere Filter</summary><div class="flex flex-wrap items-end gap-y-3 gap-x-5 py-3 px-0 [&_select]:min-h-11 [&_select]:max-w-55 [&_select]:border [&_select]:border-line [&_select]:rounded-ui [&_select]:p-2 [&_select]:bg-white [&_select]:[font:inherit]">
          <label class="grid gap-1.5 text-[13px]">Zustand<select id="condition"><option value="all">Alle Zustände</option>{conditions.map(condition => <option value={condition}>{condition}</option>)}</select></label>
          <label class="grid gap-1.5 text-[13px] [&_input]:min-h-11 [&_input]:max-w-55 [&_input]:border [&_input]:border-line [&_input]:rounded-ui [&_input]:p-2 [&_input]:bg-white [&_input]:[font:inherit]">Preis bis (€)<input id="max-price" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Alle Preise" /></label>
          <label data-ui="availability-toggle" class="flex items-center gap-1.75 min-h-11 cursor-pointer p-0 text-[13px] [&_input]:accent-brand [&_input]:w-4 [&_input]:h-4 [&_input]:m-0 max-[760px]:text-[13px]"><input type="checkbox" id="available-only" />Nur verfügbare Anzeigen</label><button class="flex items-center gap-2 bg-none bg-transparent p-2 text-[13px] w-auto min-h-11 border border-line rounded-ui [&[aria-pressed=true]]:text-brand-dark [&[aria-pressed=true]]:bg-[#e6f5fc] [&[aria-pressed=true]]:font-bold max-[760px]:w-auto max-[760px]:text-[11px]" id="free-only" aria-pressed="false"><Icon name="box" size={17} />Zu verschenken</button>
        </div></details>
      </div>
      <div class="flex justify-between items-center gap-3 py-2 mb-3 flex-wrap pt-0 px-0 pb-3 [&_>_button]:text-brand-dark [&_>_button]:bg-none [&_>_button]:bg-transparent [&_>_button]:text-[12px] [&_>_button]:font-bold [&_>_button]:py-2 [&_>_button]:px-0 [&_>_button]:min-h-9 max-[760px]:mb-0 [&_h2]:text-[20px]">
        <h2 id="listings-heading" tabindex="-1">Anzeigen <span id="result-count" role="status" aria-live="polite">({listings.length})</span></h2>
      </div>
      <div class="pt-1.25 px-2 pb-3 text-muted text-[12px] wrap-anywhere pl-0" id="active-search" hidden><span id="search-summary"></span></div>
      <div data-ui="listing-grid" class="grid grid-cols-[repeat(auto-fill,_minmax(min(100%,_230px),_260px))] gap-5 justify-start max-[760px]:grid-cols-2 max-[760px]:gap-3 max-[760px]:[[data-ui~=related-section]_&]:grid-cols-2" id="listing-grid">{listings.map((listing, index) => <ListingCard listing={listing} eager={index < 3} />)}</div>
      <div class="py-10 px-5 text-center bg-panel [&_>_svg]:text-muted [&_>_svg]:mb-3 [&_h3]:text-[18px] [&_p]:mt-3 [&_p]:mx-0 [&_p]:mb-5 [&_p]:leading-[1.6]" id="empty-state" hidden><Icon name="search" size={30} /><h3>Keine Anzeigen gefunden</h3><p>Versuche einen anderen Suchbegriff oder passe deine Filter an.</p><button class="inline-flex justify-center items-center gap-2 min-h-10 py-2.25 px-4 border border-transparent rounded-ui font-bold text-[14px] text-center bg-brand text-white [&:hover]:bg-brand-dark [[data-ui~=vertical-copy]_&]:bg-[#093d96] [[data-ui~=vertical-copy]_&]:text-white [[data-ui~=vertical-copy]_&]:mt-7 [[data-ui~=search-entry]_&]:min-h-11 max-[480px]:[[data-ui~=search-entry]_&]:px-3" id="reset-filters">Alle Anzeigen</button></div>
      <p class="text-center text-muted text-[12px] mx-0 mb-8 mt-6">Alle Anzeigen gesehen. Was dabei? Dann meld dich.</p>
    </section>
  </main>
</Layout>
<script>
  const search = document.querySelector<HTMLInputElement>('#listing-search')!;
  const available = document.querySelector<HTMLInputElement>('#available-only')!;
  const grid = document.querySelector<HTMLElement>('#listing-grid')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-listing]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
  const maxPrice = document.querySelector<HTMLInputElement>('#max-price')!;
  const condition = document.querySelector<HTMLSelectElement>('#condition')!;
  const freeButton = document.querySelector<HTMLButtonElement>('#free-only')!;
  let freeOnly = false;
  let category = 'all';
  const normalize = (value: string) => value.toLocaleLowerCase('de-AT').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ß/g, 'ss');
  function update() {
    const terms = normalize(search.value.trim()).split(/\s+/).filter(Boolean);
    const budget = maxPrice.value !== '' && Number.isFinite(maxPrice.valueAsNumber) && maxPrice.valueAsNumber >= 0 ? maxPrice.valueAsNumber : Infinity;
    const filtered = !!(terms.length || category !== 'all' || available.checked || freeOnly || budget !== Infinity || condition.value !== 'all');
    let count = 0;
    cards.forEach(card => {
      const matches = (!freeOnly || Number(card.dataset.price) === 0) && Number(card.dataset.price) <= budget && (condition.value === 'all' || card.dataset.condition === condition.value) && (category === 'all' || card.dataset.category === category) && (!available.checked || card.dataset.status === 'available') && terms.every(term => normalize(card.dataset.search || '').includes(term));
      card.hidden = !matches;
      if (matches) count++;
    });
    [...cards].sort((a, b) => (b.dataset.date || '').localeCompare(a.dataset.date || '')).forEach(card => grid.append(card));
    document.querySelector('#result-count')!.textContent = `(${count})`;
    document.querySelector<HTMLElement>('#empty-state')!.hidden = count > 0;
    document.querySelector<HTMLElement>('#active-search')!.hidden = !filtered;
    document.querySelector('#search-summary')!.textContent = [search.value.trim() ? `„${search.value.trim()}“` : '', category !== 'all' ? category : '', freeOnly ? 'Zu verschenken' : '', budget !== Infinity ? `Bis € ${budget.toLocaleString('de-AT')}` : '', condition.value !== 'all' ? condition.value : '', available.checked ? 'Nur verfügbar' : ''].filter(Boolean).join(' · ');
    freeButton.setAttribute('aria-pressed', String(freeOnly));
    const params = new URLSearchParams();
    if (freeOnly) params.set('gratis', '1');
    if (budget !== Infinity) params.set('budget', String(budget));
    if (condition.value !== 'all') params.set('zustand', condition.value);
    if (search.value.trim()) params.set('q', search.value.trim());
    if (category !== 'all') params.set('kategorie', category);
    if (available.checked) params.set('verfuegbar', '1');
    history.replaceState(null, '', `${location.pathname}${params.size ? '?' + params.toString() : ''}${location.hash}`);
  }
  function setCategory(value: string) { category = value; chips.forEach(chip => { const active = chip.dataset.categoryFilter === category; chip.setAttribute('aria-pressed', String(active)); }); }
  function restore() {
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') || '';
    freeOnly = params.get('gratis') === '1';
    const budget = params.get('budget');
    maxPrice.value = budget !== null && budget.trim() !== '' && Number.isFinite(Number(budget)) && Number(budget) >= 0 ? String(Number(budget)) : '';
    condition.value = [...condition.options].some(option => option.value === params.get('zustand')) ? params.get('zustand')! : 'all';
    const initialCategory = params.get('kategorie') || 'all';
    setCategory(chips.some(chip => chip.dataset.categoryFilter === initialCategory) ? initialCategory : 'all');
    available.checked = params.get('verfuegbar') === '1';
    document.querySelector<HTMLDetailsElement>('[data-additional-filters]')!.open = freeOnly || maxPrice.value !== '' || condition.value !== 'all' || available.checked;
    update();
  }
  function resetFilters() {
    search.value = ''; setCategory('all'); available.checked = false;
    freeOnly = false; maxPrice.value = ''; condition.value = 'all'; update();
  }
  search.addEventListener('input', update);
  document.querySelector('#listing-search-form')!.addEventListener('submit', event => { event.preventDefault(); update(); document.querySelector<HTMLElement>('#listings-heading')!.focus({ preventScroll: true }); });
  freeButton.addEventListener('click', () => { freeOnly = !freeOnly; update(); });
  maxPrice.addEventListener('input', update);
  condition.addEventListener('change', update);
  chips.forEach(chip => chip.addEventListener('click', () => { setCategory(chip.dataset.categoryFilter!); update(); document.querySelector<HTMLElement>('#listings-heading')!.focus({ preventScroll: true }); document.querySelector('#dinge')!.scrollIntoView({ behavior: 'smooth', block: 'start' }); }));
  available.addEventListener('change', update);

  document.querySelector('#reset-filters')!.addEventListener('click', resetFilters);
  window.addEventListener('pageshow', restore);
  window.addEventListener('popstate', restore);
  restore();
</script>
