---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { verticals } from "../data/verticals";
export function getStaticPaths() {
  return verticals.map((vertical) => ({
    params: { vertical: vertical.slug },
    props: { vertical },
  }));
}
const { vertical } = Astro.props;
---

<Layout title={`${vertical.name} – Meinhaben`} description={vertical.text}>
  <main id="main" class="vertical-page">
    <section class="vertical-hero" data-vertical={vertical.slug}>
      <div data-ui="vertical-copy" class="vertical-copy">
        <p data-ui="showcase-kicker" class="showcase-kicker">
          {vertical.name} · {vertical.kicker}
        </p>
        <h1>{vertical.headline}</h1>
        <p>{vertical.text}</p>
        <a class="vertical-cta" href={vertical.href}>
          {vertical.cta}
          <Icon name="right" size={18} />
        </a>
      </div>
      <div class="vertical-art" aria-hidden="true">
        <span>{vertical.symbol}</span>
        <small>
          MEINHABEN
          <br />
          {vertical.name.toUpperCase()}
        </small>
      </div>
    </section>
    <div class="vertical-facts">
      {vertical.facts.map((fact, index) => (
        <div>
          <span>0{index + 1}</span>
          <p>{fact}</p>
        </div>
      ))}
    </div>
    <div class="vertical-note">
      <Icon name={vertical.icon} size={28} />
      <div>
        <h2>{vertical.stamp}</h2>
        <p>
          Hier gibt’s nur einen kleinen Schmäh. Meine echten Sachen findest du
          am Marktplatz.
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .vertical-page {
    margin-inline: auto;
    width: min(1440px, calc(100% - 2 * var(--page-gutter)));
    padding-top: 29px;
    padding-bottom: 48px;
    @media (width < 760px) {
      padding-top: 20px;
    }
  }
  .vertical-hero {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    overflow: hidden;
    border-radius: 6px;
    background-color: #e9f7ff;
    color: #083d84;
    @media (width < 760px) {
      grid-template-columns: 1fr;
    }
    &[data-vertical="auto-motor"] {
      background-color: #e8f7ef;
      color: #225c43;
    }
    &[data-vertical="jobs"] {
      background-color: #f2ebff;
      color: #542695;
    }
  }
  .vertical-copy {
    padding-inline: 36px;
    padding-block: 44px;
    @media (width < 760px) {
      padding-inline: 24px;
      padding-block: 30px;
    }
    & > p:not([data-ui~="showcase-kicker"]) {
      font-size: 14px;
      line-height: 1.9;
    }
    & h1 {
      margin-bottom: 22px;
      font-size: clamp(30px, 4vw, 44px);
      line-height: 1.13;
      font-weight: 800;
      letter-spacing: -1.4px;
    }
  }
  .showcase-kicker {
    margin-bottom: 18px;
    font-size: 11px;
    line-height: 1.7;
    font-weight: 700;
    letter-spacing: 1.3px;
    text-transform: uppercase;
  }
  .vertical-cta {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--radius-ui);
    border: 1px solid transparent;
    padding-inline: 16px;
    padding-block: 9px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    margin-top: 28px;
    background-color: #093d96;
    color: white;
  }
  .vertical-art {
    display: flex;
    transform: rotate(-6deg) scale(1.12);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #19acf0;
    @media (width < 760px) {
      min-height: 180px;
      transform: none;
    }
    & > span {
      font-size: 140px;
      line-height: 1.3;
    }
    @media (width < 760px) {
      & > span {
        font-size: 90px;
      }
    }
    & small {
      text-align: center;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 3px;
    }
    @media (width < 760px) {
      & small {
        margin-bottom: 20px;
      }
    }
    :global([data-vertical="auto-motor"]) & {
      background-color: #8bd4af;
    }
    :global([data-vertical="jobs"]) & {
      background-color: #d0b1ff;
    }
  }
  .vertical-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding-inline: 0;
    padding-block: 30px;
    @media (width < 760px) {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    & > div {
      padding-bottom: 22px;
    }
    & p {
      margin-top: 8px;
      line-height: 1.6;
    }
    & span {
      font-size: 24px;
      font-weight: 800;
      color: var(--color-brand);
    }
  }
  .vertical-note {
    display: flex;
    align-items: center;
    gap: 18px;
    border-radius: var(--radius-ui);
    background-color: var(--color-panel);
    padding: 24px;
    @media (width < 760px) {
      align-items: flex-start;
      padding: 20px;
    }
    & p {
      margin-top: 8px;
      line-height: 1.7;
      color: var(--color-muted);
    }
    & :global(svg) {
      color: var(--color-brand);
    }
  }
</style>
